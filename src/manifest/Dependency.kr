package krelp.manifest;

import krelp.semver.VersionReq;
import krelp.toml.TomlWriter;

final class Dependency {
    private String name;
    private DepKind kind;
    private VersionReq req;
    private boolean dev;

    Dependency(String name, DepKind kind, VersionReq req, boolean dev) {
        this.name = name;
        this.kind = kind;
        this.req = req;
        this.dev = dev;
    }

    Dependency copy() {
        return new Dependency(this.name, this.kind, this.req.copy(), this.dev);
    }

    String name() {
        return this.name;
    }

    &DepKind kind() {
        return &this.kind;
    }

    &VersionReq req() {
        return &this.req;
    }

    boolean dev() {
        return this.dev;
    }

    boolean isRegistry() {
        return switch (this.kind) {
            case Registry -> true;
            default -> false;
        };
    }

    String toToml() {
        String version = this.req.toString();
        String quoted = TomlWriter.string(version);
        return switch (this.kind) {
            case Registry -> quoted;
            case Path(String dir) -> version == "*"
                ? "{ path = ${TomlWriter.string(dir)} }"
                : "{ path = ${TomlWriter.string(dir)}, version = $quoted }";
            case Git(String url, GitRef ref) -> "{ git = ${TomlWriter.string(url)}${Dependency.refEntry(&ref)} }";
        };
    }

    private static String refEntry(&GitRef ref) {
        return switch (ref) {
            case DefaultBranch -> "";
            case Branch(String name) -> ", branch = ${TomlWriter.string(name)}";
            case Tag(String name) -> ", tag = ${TomlWriter.string(name)}";
            case Rev(String rev) -> ", rev = ${TomlWriter.string(rev)}";
        };
    }
}
