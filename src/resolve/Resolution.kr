package krelp.resolve;

import krelp.lock.LockedPackage;
import krelp.lock.Lockfile;
import krelp.manifest.Dependency;
import krelp.manifest.Manifest;
import krelp.source.GitCache;
import krelp.source.SourceId;
import krelp.util.Fs;
import krelp.util.KrelpException;
import krelp.util.Shell;
import std.io.Path;
import std.util.ArrayList;
import std.util.List;

final class Resolution {
    private List<Node> nodes;

    Resolution(Node root) {
        this.nodes = new ArrayList<>();
        this.nodes.add(root);
    }

    mut void add(Node node) {
        this.nodes.add(node);
    }

    &Node root() {
        return this.nodes.get(0);
    }

    &List<Node> nodes() {
        return &this.nodes;
    }

    (&Node)? find(&String name) {
        for (&Node node : &this.nodes) {
            if (node.name() == name) {
                return node;
            }
        }
        return null;
    }

    mut void fetch(&mut GitCache git, Shell shell) throws KrelpException {
        for (int i = 1; i < this.nodes.size(); i++) {
            &Node node = this.nodes.get(i);
            String? repository = node.repository();
            String? commit = node.commit();
            if (node.isFetched() || repository == null || commit == null) {
                continue;
            }
            if (!git.isCheckedOut(repository, commit)) {
                shell.status("Downloading", node.toString());
            }
            String dir = git.checkout(repository, commit);
            Manifest manifest = Manifest.read(dir, shell);
            if (manifest.name() != node.name() || manifest.version() != node.version()) {
                throw new KrelpException(
                    "the registry says `$repository` holds `${node.name()}` v${node.version()} "
                    + "at commit $commit, but it holds `${manifest.name()}` v${manifest.version()}"
                );
            }
            Node fetched = node.copy() with { dir = dir };
            this.nodes.set(i, fetched);
        }
    }

    List<Library> libraries(boolean dev) {
        List<String> reached = new ArrayList<>();
        this.reach(this.root(), dev, &mut reached);
        List<Library> libraries = new ArrayList<>();
        for (&String name : &reached) {
            (&Node)? node = this.find(name);
            if (node != null) {
                libraries.add(new Library(node.name(), Path.join(node.dir(), "src")));
            }
        }
        return libraries;
    }

    Lockfile lockfile() {
        List<LockedPackage> packages = new ArrayList<>();
        String rootDir = this.root().dir();
        for (int i = 1; i < this.nodes.size(); i++) {
            &Node node = this.nodes.get(i);
            List<String> deps = node.dependencyNames();
            deps.sort();
            SourceId source = switch (node.source()) {
                case Path(String dir) -> SourceId.Path(Fs.relative(rootDir, dir));
                default -> node.source();
            };
            packages.add(new LockedPackage(node.name(), node.version(), source, node.commit(), deps));
        }
        packages.sort((a, b) -> a.name().compareTo(&b.name()));
        return new Lockfile(packages);
    }

    String tree() {
        StringBuilder out = new StringBuilder();
        &Node root = this.root();
        out.appendLine(root.toString());
        List<String> seen = new ArrayList<>();
        List<String> normal = new ArrayList<>();
        List<String> dev = new ArrayList<>();
        for (&Dependency dep : root.dependencies()) {
            if (dep.dev()) {
                dev.add(dep.name());
            } else {
                normal.add(dep.name());
            }
        }
        this.branches(&mut out, &normal, "", &mut seen);
        if (!dev.isEmpty()) {
            out.appendLine("");
            out.appendLine("[dev-dependencies]");
            this.branches(&mut out, &dev, "", &mut seen);
        }
        return out.toString();
    }

    private void branches(&mut StringBuilder out, &List<String> names, String indent, &mut List<String> seen) {
        for (int i = 0; i < names.size(); i++) {
            boolean last = i == names.size() - 1;
            (&Node)? node = this.find(names.get(i));
            if (node == null) {
                continue;
            }
            String origin = switch (node.source()) {
                case Path(String dir) -> Fs.relative(this.root().dir(), dir);
                default -> node.source().describe();
            };
            String shown = origin.isEmpty() ? node.toString() : "${node} ($origin)";
            boolean again = seen.contains(&node.name());
            out.appendLine("$indent${last ? "└── " : "├── "}$shown${again ? " (*)" : ""}");
            if (again) {
                continue;
            }
            seen.add(node.name());
            this.branches(out, &node.dependencyNames(), indent + (last ? "    " : "│   "), seen);
        }
    }

    private void reach(&Node node, boolean dev, &mut List<String> reached) {
        for (&Dependency dep : node.dependencies()) {
            if (dep.dev() && !dev) {
                continue;
            }
            if (reached.contains(&dep.name())) {
                continue;
            }
            reached.add(dep.name());
            (&Node)? child = this.find(&dep.name());
            if (child != null) {
                this.reach(child, false, reached);
            }
        }
    }
}
