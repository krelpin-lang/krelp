package krelp.toml;

import std.util.List;

final class TomlWriter {
    private TomlWriter() {}

    static String key(String key) {
        if (key.isEmpty()) {
            return "\"\"";
        }
        for (char c : key.chars()) {
            if (!TomlWriter.isBareKeyChar(c)) {
                return TomlWriter.string(key);
            }
        }
        return key;
    }

    static String path(&List<String> parts) {
        StringBuilder text = new StringBuilder();
        for (int i = 0; i < parts.size(); i++) {
            if (i > 0) {
                text.append(".");
            }
            text.append(TomlWriter.key(parts.get(i)));
        }
        return text.toString();
    }

    static String string(String value) {
        StringBuilder text = new StringBuilder();
        text.append('"');
        for (char c : value.chars()) {
            if (c == '"') {
                text.append("\\\"");
            } else if (c == '\\') {
                text.append("\\\\");
            } else if (c == '\n') {
                text.append("\\n");
            } else if (c == '\t') {
                text.append("\\t");
            } else if (c == '\r') {
                text.append("\\r");
            } else if (c < ' ' || c == '\u{7F}') {
                text.append("\\u" + ((int) c).format("04X"));
            } else {
                text.append(c);
            }
        }
        text.append('"');
        return text.toString();
    }

    static boolean isBareKeyChar(char c) {
        return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')
            || c == '_' || c == '-';
    }
}
