package krelp.lock;

import krelp.source.SourceId;
import krelp.toml.TomlException;
import krelp.toml.TomlParser;
import krelp.toml.TomlTable;
import krelp.toml.TomlValue;
import krelp.util.KrelpException;
import std.io.Files;
import std.io.IOException;
import std.io.Path;
import std.util.ArrayList;
import std.util.List;

record Lockfile(List<LockedPackage> packages) {
    public static String FILE = "krelp.lock";

    static Lockfile? read(String dir) throws KrelpException {
        String file = Path.join(dir, Lockfile.FILE);
        if (!Files.isFile(file)) {
            return null;
        }
        try {
            return Lockfile.parse(Files.readString(file), file);
        } catch (IOException e) {
            throw new KrelpException(e.getMessage() ?: "couldn't read `$file`");
        }
    }

    static Lockfile parse(String text, String file) throws KrelpException {
        List<LockedPackage> packages = new ArrayList<>();
        try {
            TomlTable root = TomlParser.parse(text, file);
            long version = root.integer("version", 1L);
            if (version != 1L) {
                throw new KrelpException(
                    "$file has version $version, which this krelp does not understand",
                    "delete it to have krelp write a new one"
                );
            }
            (&List<TomlValue>)? items = root.array("package");
            if (items != null) {
                for (&TomlValue item : items) {
                    switch (item) {
                        case Table(TomlTable table) -> packages.add(LockedPackage.fromToml(&table, file));
                        default -> throw new KrelpException("$file: `package` must be an array of tables");
                    }
                }
            }
        } catch (TomlException e) {
            throw new KrelpException(
                e.getMessage() ?: "`$file` is not valid TOML",
                "delete it to have krelp write a new one"
            );
        }
        return new Lockfile(packages);
    }

    (&LockedPackage)? find(&String name) {
        for (&LockedPackage locked : this.packages) {
            if (locked.name() == name) {
                return locked;
            }
        }
        return null;
    }

    (&LockedPackage)? findFrom(&String name, &SourceId source) {
        (&LockedPackage)? locked = this.find(name);
        if (locked == null || locked.source().key() != source.key()) {
            return null;
        }
        return locked;
    }

    void write(String dir) throws KrelpException {
        String file = Path.join(dir, Lockfile.FILE);
        String text = this.toToml();
        try {
            if (Files.isFile(file) && Files.readString(file) == text) {
                return;
            }
            Files.writeString(file, text);
        } catch (IOException e) {
            throw new KrelpException(e.getMessage() ?: "couldn't write `$file`");
        }
    }

    String toToml() {
        StringBuilder out = new StringBuilder();
        out.appendLine("# This file is written by krelp. Do not edit it by hand.");
        out.appendLine("version = 1");
        for (&LockedPackage locked : this.packages) {
            out.appendLine("");
            out.append(locked.toToml());
        }
        return out.toString();
    }
}
