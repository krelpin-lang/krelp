package krelp.source;

import std.io.Path;

record Home(String dir) {
    static Home fromEnv() {
        String? home = System.env("KRELP_HOME");
        if (home != null && !home.isEmpty()) {
            return new Home(home);
        }
        return new Home(Path.join(System.env("HOME") ?: "/", ".krelp"));
    }

    String gitDb(String url) {
        return Path.join(Path.join(this.dir, "git/db"), this.name(url));
    }

    String checkout(String url, String commit) {
        return Path.join(Path.join(Path.join(this.dir, "git/checkouts"), this.name(url)), commit);
    }

    String index(String url) {
        return Path.join(Path.join(this.dir, "index"), this.name(url));
    }

    private String name(String url) {
        String base = Path.fileName(url.endsWith("/") ? url.substring(0, url.length() - 1) : url);
        String? stripped = base.stripSuffix(".git");
        if (stripped != null) {
            base = stripped;
        }
        StringBuilder safe = new StringBuilder();
        for (char c : base.chars()) {
            boolean ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
                || (c >= '0' && c <= '9') || c == '_' || c == '-' || c == '.';
            if (ok) {
                safe.append(c);
            } else {
                safe.append('_');
            }
        }
        long hash = -3750763034362895579L;
        for (byte b : url.bytes()) {
            hash = hash ^ ((long) b & 255L);
            hash = hash * 1099511628211L;
        }
        long high = (hash >>> 32) & 4294967295L;
        long low = hash & 4294967295L;
        return "${safe}-${high.format("08x")}${low.format("08x")}";
    }
}
