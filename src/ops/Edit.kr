package krelp.ops;

import krelp.manifest.Dependency;
import krelp.manifest.Manifest;
import krelp.manifest.ManifestEditor;
import krelp.util.KrelpException;
import std.io.Files;
import std.io.IOException;
import std.util.List;

final class Edit borrows krelp {
    private final &mut Krelp krelp;
    private final Manifest manifest;
    private final String original;
    private final ManifestEditor editor;

    Edit(&mut Krelp krelp) keeps krelp throws KrelpException {
        Manifest manifest = krelp.manifest();
        this.krelp = krelp;
        this.original = manifest.text();
        this.editor = new ManifestEditor(this.original);
        this.manifest = manifest;
    }

    mut void add(Dependency dependency) throws KrelpException {
        String value = dependency.toToml();
        if (dependency.isRegistry() && dependency.req().acceptsAny()) {
            value = "\"${this.krelp.sources().index().newest(dependency.name())}\"";
        }
        String section = dependency.dev() ? "dev-dependencies" : "dependencies";
        String other = dependency.dev() ? "dependencies" : "dev-dependencies";
        this.editor.remove(other, dependency.name());
        this.editor.set(section, dependency.name(), value);
        this.krelp.shell().status("Adding", "${dependency.name()} = $value to [$section]");
    }

    mut void remove(&List<String> names, boolean dev) throws KrelpException {
        for (&String name : names) {
            boolean removed = this.editor.remove("dev-dependencies", name);
            if (!dev) {
                removed = this.editor.remove("dependencies", name) || removed;
            }
            if (!removed) {
                throw new KrelpException(
                    "`${this.manifest.name()}` has no ${dev ? "dev-dependency" : "dependency"} named `$name`"
                );
            }
            this.krelp.shell().status("Removing", name);
        }
    }

    mut void save() throws KrelpException {
        String file = this.manifest.file();
        this.write(file, this.editor.text());
        try {
            Manifest changed = Manifest.read(this.manifest.dir(), this.krelp.shell());
            this.krelp.resolve(changed, &LockOptions.keep(false));
        } catch (KrelpException e) {
            this.write(file, this.original);
            throw e;
        }
    }

    private void write(String file, String text) throws KrelpException {
        try {
            Files.writeString(file, text);
        } catch (IOException e) {
            throw new KrelpException(e.getMessage() ?: "couldn't write `$file`");
        }
    }
}
