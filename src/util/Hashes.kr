package krelp.util;

final class Hashes {
    private Hashes() {}

    static String fnv64(String text) {
        long hash = -3750763034362895579L;
        for (byte b : text.bytes()) {
            hash = hash ^ ((long) b & 255L);
            hash = hash * 1099511628211L;
        }
        long high = (hash >>> 32) & 4294967295L;
        long low = hash & 4294967295L;
        return high.format("08x") + low.format("08x");
    }
}
