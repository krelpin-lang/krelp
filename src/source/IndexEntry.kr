package krelp.source;

import krelp.manifest.DepKind;
import krelp.manifest.Dependency;
import krelp.semver.SemverException;
import krelp.semver.Version;
import krelp.semver.VersionReq;
import krelp.toml.TomlException;
import krelp.toml.TomlTable;
import krelp.toml.TomlWriter;
import krelp.util.KrelpException;
import std.util.ArrayList;
import std.util.List;

record IndexEntry(String name, Version version, String git, String rev, List<Dependency> dependencies, boolean yanked) {
    static IndexEntry fromToml(String name, &TomlTable table, String file) throws TomlException, KrelpException {
        Version version;
        try {
            version = Version.parse(table.requireString("version"));
        } catch (SemverException e) {
            throw new KrelpException("$file: ${e.getMessage() ?: ""}");
        }
        List<Dependency> dependencies = new ArrayList<>();
        (&TomlTable)? deps = table.table("dependencies");
        if (deps != null) {
            for (&String dep : deps.keys()) {
                String req = deps.requireString(dep);
                try {
                    dependencies.add(new Dependency(dep, DepKind.Registry, VersionReq.parse(req), false));
                } catch (SemverException e) {
                    throw new KrelpException("$file: `${deps.qualify(dep)}`: ${e.getMessage() ?: ""}");
                }
            }
        }
        String rev = table.requireString("rev");
        if (!Repository.isCommitHash(&rev)) {
            throw new KrelpException(
                "$file: `$name` v$version has `rev = \"$rev\"`, which is not a full commit hash",
                "an index entry must pin the exact commit, because a branch or tag can be moved to other code"
            );
        }
        return new IndexEntry(
            name,
            version,
            table.requireString("git"),
            rev,
            dependencies,
            table.bool("yanked", false)
        );
    }

    boolean isStable() {
        return !this.yanked && !this.version.isPrerelease();
    }

    String toToml() {
        StringBuilder out = new StringBuilder();
        out.appendLine("[[version]]");
        out.appendLine("version = ${TomlWriter.string(this.version.toString())}");
        out.appendLine("git = ${TomlWriter.string(this.git)}");
        out.appendLine("rev = ${TomlWriter.string(this.rev)}");
        StringBuilder deps = new StringBuilder();
        for (&Dependency dep : this.dependencies) {
            if (!deps.isEmpty()) {
                deps.append(", ");
            }
            deps.append("${TomlWriter.key(dep.name())} = ${TomlWriter.string(dep.req().toString())}");
        }
        out.appendLine(deps.isEmpty() ? "dependencies = {}" : "dependencies = { $deps }");
        out.appendLine("yanked = ${this.yanked}");
        return out.toString();
    }
}
