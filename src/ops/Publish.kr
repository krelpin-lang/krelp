package krelp.ops;

import krelp.build.Profile;
import krelp.manifest.Dependency;
import krelp.manifest.Manifest;
import krelp.semver.Version;
import krelp.source.Index;
import krelp.source.IndexEntry;
import krelp.source.Repository;
import krelp.util.Fs;
import krelp.util.KrelpException;
import krelp.util.Shell;
import std.io.Files;
import std.io.IOException;
import std.util.ArrayList;
import std.util.List;

final class Publish borrows krelp {
    private &mut Krelp krelp;
    private boolean dryRun;
    private boolean allowDirty;

    Publish(&mut Krelp krelp, boolean dryRun, boolean allowDirty) keeps krelp {
        this.krelp = krelp;
        this.dryRun = dryRun;
        this.allowDirty = allowDirty;
    }

    mut void run() throws KrelpException {
        Shell shell = this.krelp.shell();
        Manifest manifest = this.krelp.manifest();
        String name = manifest.name();
        if (manifest.isProgram()) {
            throw new KrelpException(
                "`$name` is a program; only libraries can be published",
                "a library has no `src/Main.kr`"
            );
        }
        List<Dependency> dependencies = this.publishedDependencies(&manifest);
        Repository repo = this.checkedRepository(&manifest);
        String commit = repo.run("rev-parse", "HEAD").trim();
        String repository = this.remoteUrl(&manifest, repo);
        String remote = repo.tryRun("branch", "--remotes", "--contains", commit) ?: "";
        if (remote.trim().isEmpty()) {
            throw new KrelpException(
                "the commit $commit is not on any remote branch, so others cannot fetch it",
                "push it first"
            );
        }

        {
            &mut Index index = this.krelp.sources().index();
            index.update();
            if (index.has(name, &manifest.version())) {
                throw new KrelpException(
                    "`$name` v${manifest.version()} is already in the registry",
                    "raise `version` in `${Manifest.FILE}` to publish a new version"
                );
            }
        }
        Version version = manifest.version();
        shell.status("Verifying", "$name v$version");
        Project project = this.krelp.resolve(manifest, &LockOptions.keep(false));
        new Builder(project, Profile.DEBUG, this.krelp).check();

        IndexEntry entry = new IndexEntry(name, version, repository, commit, dependencies, false);
        String section = entry.toToml();
        if (this.dryRun) {
            shell.status("Skipping", "the upload of this entry because of `--dry-run`:");
            Console.print(section);
            return;
        }
        &mut Index index = this.krelp.sources().index();
        String file = index.file(name);
        try {
            String existing = Files.isFile(file) ? Files.readString(file) : "";
            String separator = existing.isEmpty() || existing.endsWith("\n\n") ? "" : existing.endsWith("\n") ? "\n" : "\n\n";
            Fs.write(file, existing + separator + section);
        } catch (IOException e) {
            throw new KrelpException(e.getMessage() ?: "couldn't write `$file`");
        }
        Repository registry = index.repository();
        registry.run("add", file);
        registry.run("commit", "--quiet", "-m", "publish $name v$version");
        shell.status("Uploading", "$name v$version to ${index.url()}");
        if (registry.tryRun("push", "--quiet", "origin", "HEAD") == null) {
            throw new KrelpException(
                "couldn't push the registry index ${index.url()}",
                "the entry is committed in `${index.dir()}`; push it yourself, or open a pull request with it"
            );
        }
        shell.status("Published", "$name v$version");
    }

    private List<Dependency> publishedDependencies(&Manifest manifest) throws KrelpException {
        List<Dependency> dependencies = new ArrayList<>();
        for (&Dependency dep : manifest.dependencies()) {
            if (dep.dev()) {
                continue;
            }
            if (!dep.isRegistry()) {
                throw new KrelpException(
                    "`${manifest.name()}` depends on `${dep.name()}` by `path` or `git`, which others cannot fetch",
                    "publish `${dep.name()}` to the registry and depend on it by version"
                );
            }
            dependencies.add(dep.copy());
        }
        return dependencies;
    }

    private Repository checkedRepository(&Manifest manifest) throws KrelpException {
        String dir = manifest.dir();
        Repository repo = new Repository(dir);
        if (!repo.isWorkTree()) {
            throw new KrelpException("`$dir` is not in a git repository, which is where the registry finds its code");
        }
        String status = repo.run("status", "--porcelain", "--untracked-files=no", ".");
        if (!status.trim().isEmpty() && !this.allowDirty) {
            throw new KrelpException(
                "`${manifest.name()}` has changes that are not committed:\n${status.trimEnd()}",
                "commit them first, or pass `--allow-dirty` to publish the last commit anyway"
            );
        }
        String top = repo.run("rev-parse", "--show-toplevel").trim();
        boolean atRoot;
        try {
            atRoot = Files.canonicalPath(top) == Files.canonicalPath(dir);
        } catch (IOException e) {
            atRoot = false;
        }
        if (!atRoot) {
            throw new KrelpException(
                "`$dir` is not the root of its git repository",
                "the registry expects `${Manifest.FILE}` at the root of the repository"
            );
        }
        return repo;
    }

    private String remoteUrl(&Manifest manifest, Repository repo) throws KrelpException {
        String? configured = manifest.repository();
        if (configured != null) {
            return configured;
        }
        String? origin = repo.tryRun("remote", "get-url", "origin");
        if (origin == null || origin.trim().isEmpty()) {
            throw new KrelpException(
                "couldn't tell where others can fetch `${manifest.name()}` from",
                "set `repository` in `[package]`, or add a git remote named `origin`"
            );
        }
        return origin.trim();
    }
}
