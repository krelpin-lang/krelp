package krelp.semver;

import std.util.ArrayList;
import std.util.List;

record Partial(int major, int minor, int patch, String pre, boolean wildcard) {
    static Partial parse(String part, String text) throws SemverException {
        String core = part;
        int plus = core.indexOf("+");
        if (plus >= 0) {
            core = core.substring(0, plus);
        }
        String pre = "";
        int dash = core.indexOf("-");
        if (dash >= 0) {
            pre = core.substring(dash + 1);
            core = core.substring(0, dash);
        }
        String[] parts = core.split(".");
        if (parts.length > 3) {
            throw new SemverException("`$text` has a version with more than three numbers");
        }
        int[] numbers = {-1, -1, -1};
        boolean wildcard = false;
        for (int i = 0; i < parts.length; i++) {
            String piece = parts[i];
            if (piece == "*" || piece == "x" || piece == "X") {
                if (i == 0) {
                    throw new SemverException("`$text` must start with a number");
                }
                wildcard = true;
            } else if (wildcard) {
                throw new SemverException("`$text` has a number after a wildcard");
            } else {
                numbers[i] = Version.number(piece, text);
            }
        }
        if (!pre.isEmpty() && numbers[2] < 0) {
            throw new SemverException("`$text` has a pre-release tag on an incomplete version");
        }
        return new Partial(numbers[0], numbers[1], numbers[2], pre, wildcard);
    }

    List<Bound> bounds(String op, String text) throws SemverException {
        if (this.wildcard && op != "^") {
            throw new SemverException("`$text` combines `$op` with a wildcard");
        }
        List<Bound> bounds = new ArrayList<>();
        if (op == "^") {
            bounds.add(new Bound(Op.GREATER_EQ, this.lower()));
            bounds.add(new Bound(Op.LESS, this.wildcard ? this.bumpLast() : this.caretUpper()));
        } else if (op == "~") {
            bounds.add(new Bound(Op.GREATER_EQ, this.lower()));
            bounds.add(new Bound(Op.LESS, this.tildeUpper()));
        } else if (op == "=") {
            if (this.complete()) {
                bounds.add(new Bound(Op.EXACT, this.lower()));
            } else {
                bounds.add(new Bound(Op.GREATER_EQ, this.lower()));
                bounds.add(new Bound(Op.LESS, this.bumpLast()));
            }
        } else if (op == ">=") {
            bounds.add(new Bound(Op.GREATER_EQ, this.lower()));
        } else if (op == ">") {
            bounds.add(this.complete()
                ? new Bound(Op.GREATER, this.lower())
                : new Bound(Op.GREATER_EQ, this.bumpLast()));
        } else if (op == "<") {
            bounds.add(new Bound(Op.LESS, this.lower()));
        } else {
            bounds.add(this.complete()
                ? new Bound(Op.LESS_EQ, this.lower())
                : new Bound(Op.LESS, this.bumpLast()));
        }
        return bounds;
    }

    boolean complete() {
        return this.patch >= 0;
    }

    Version lower() {
        return new Version(
            this.major,
            this.minor < 0 ? 0 : this.minor,
            this.patch < 0 ? 0 : this.patch,
            this.pre
        );
    }

    Version bumpLast() {
        if (this.minor < 0) {
            return Version.of(this.major + 1, 0, 0);
        }
        if (this.patch < 0) {
            return Version.of(this.major, this.minor + 1, 0);
        }
        return Version.of(this.major, this.minor, this.patch + 1);
    }

    Version caretUpper() {
        if (this.major > 0 || this.minor < 0) {
            return Version.of(this.major + 1, 0, 0);
        }
        if (this.minor > 0 || this.patch < 0) {
            return Version.of(0, this.minor + 1, 0);
        }
        return Version.of(0, 0, this.patch + 1);
    }

    Version tildeUpper() {
        if (this.minor < 0) {
            return Version.of(this.major + 1, 0, 0);
        }
        return Version.of(this.major, this.minor + 1, 0);
    }
}
