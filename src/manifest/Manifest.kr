package krelp.manifest;

import krelp.semver.Version;
import krelp.util.KrelpException;
import krelp.util.Shell;
import std.io.Files;
import std.io.IOException;
import std.io.Path;
import std.util.List;

record Manifest(
    String dir,
    String name,
    Version version,
    String? edition,
    String? description,
    String? license,
    String? repository,
    List<String> authors,
    List<Dependency> dependencies
) {
    public static final String FILE = "krelp.toml";

    static Manifest find(String start, Shell shell) throws KrelpException {
        String dir = start;
        while (true) {
            if (Files.isFile(Path.join(dir, Manifest.FILE))) {
                return Manifest.read(dir, shell);
            }
            String parent = Path.parent(dir);
            if (parent.isEmpty() || parent == dir) {
                throw new KrelpException(
                    "couldn't find `${Manifest.FILE}` in `$start` or any directory above it",
                    "run `krelp new NAME` to create a package"
                );
            }
            dir = parent;
        }
    }

    static Manifest read(String dir, Shell shell) throws KrelpException {
        String file = Path.join(dir, Manifest.FILE);
        if (!Files.isFile(file)) {
            throw new KrelpException("`$dir` has no `${Manifest.FILE}`");
        }
        String text;
        try {
            text = Files.readString(file);
        } catch (IOException e) {
            throw new KrelpException(e.getMessage() ?: "couldn't read `$file`");
        }
        return new ManifestParser(file, shell).parse(text, dir);
    }

    static Manifest parse(String text, String dir, String file, Shell shell) throws KrelpException {
        return new ManifestParser(file, shell).parse(text, dir);
    }

    static String? checkName(String name) {
        if (name.isEmpty()) {
            return "the package name is empty";
        }
        char[] chars = name.chars();
        if (chars[0] >= '0' && chars[0] <= '9') {
            return "the package name `$name` starts with a digit";
        }
        for (char c : chars) {
            boolean ok = (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_';
            if (!ok) {
                return "the package name `$name` may only use lowercase letters, digits and `_`, "
                    + "because it is also the name of the package in Krelpin code";
            }
        }
        if (name == "std" || name == "tests") {
            return "the package name `$name` is reserved";
        }
        return null;
    }

    String srcDir() {
        return Path.join(this.dir, "src");
    }

    String testsDir() {
        return Path.join(this.dir, "tests");
    }

    String file() {
        return Path.join(this.dir, Manifest.FILE);
    }

    String targetDir() {
        return Path.join(this.dir, "target");
    }

    boolean isProgram() {
        return Files.isFile(Path.join(this.srcDir(), "Main.kr"));
    }

    boolean dependsOn(&String name) {
        for (&Dependency dep : this.dependencies) {
            if (dep.name() == name) {
                return true;
            }
        }
        return false;
    }

    String text() throws KrelpException {
        String file = this.file();
        try {
            return Files.readString(file);
        } catch (IOException e) {
            throw new KrelpException(e.getMessage() ?: "couldn't read `$file`");
        }
    }
}
