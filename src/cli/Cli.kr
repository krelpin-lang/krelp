package krelp.cli;

import krelp.build.Profile;
import krelp.manifest.DepKind;
import krelp.manifest.Dependency;
import krelp.manifest.GitRef;
import krelp.manifest.Manifest;
import krelp.ops.Builder;
import krelp.ops.Edit;
import krelp.ops.Krelp;
import krelp.ops.LockOptions;
import krelp.ops.Project;
import krelp.ops.Publish;
import krelp.ops.Scaffold;
import krelp.semver.SemverException;
import krelp.semver.VersionReq;
import krelp.util.Fs;
import krelp.util.KrelpException;
import krelp.util.Shell;
import std.io.Files;
import std.io.IOException;
import std.util.List;

final class Cli {
    public static String VERSION = "0.1.0";

    private Shell shell;

    Cli() {
        this.shell = new Shell(false);
    }

    mut int run(&String[] argv) {
        int first = 0;
        while (first < argv.length && argv[first].startsWith("-")) {
            String option = argv[first];
            if (option == "-q" || option == "--quiet") {
                this.shell = new Shell(true);
            } else if (option == "-V" || option == "--version") {
                Console.println("krelp ${Cli.VERSION}");
                return 0;
            } else if (option == "-h" || option == "--help") {
                Console.print(Command.overview());
                return 0;
            } else {
                this.shell.error("krelp has no option `$option`", "run `krelp help` to see the options");
                return 2;
            }
            first++;
        }
        if (first >= argv.length) {
            Console.print(Command.overview());
            return 2;
        }
        Command? command = Command.parse(argv[first]);
        if (command == null) {
            this.shell.error("krelp has no command `${argv[first]}`", "run `krelp help` to see the commands");
            return 1;
        }
        Args args = new Args(argv, first + 1);
        if (args.flag("-h", "--help")) {
            Console.print(command.help());
            return 0;
        }
        Krelp krelp = Krelp.fromEnv(this.shell);
        try {
            return this.dispatch(command, &mut args, &mut krelp);
        } catch (KrelpException e) {
            this.shell.error(e.getMessage() ?: "krelp failed", e.help());
            return 1;
        }
    }

    private int dispatch(Command command, &mut Args args, &mut Krelp krelp) throws KrelpException {
        String word = command.word();
        if (command.builds()) {
            Profile profile = args.flag("--release", "-r") ? Profile.RELEASE : Profile.DEBUG;
            LockOptions options = LockOptions.keep(args.flag("--locked"));
            args.finish(word);
            Builder builder = new Builder(krelp.load(&options), profile, krelp);
            switch (command) {
                case BUILD -> builder.build();
                case CHECK -> builder.check();
                case RUN -> {
                    return builder.run(args.passthrough());
                }
                default -> builder.test();
            }
            return 0;
        }
        switch (command) {
            case HELP -> {
                List<String> topics = args.positionals();
                args.finish(word);
                if (topics.isEmpty()) {
                    Console.print(Command.overview());
                    return 0;
                }
                Command? topic = Command.parse(topics.get(0));
                if (topic == null) {
                    this.shell.error("krelp has no command `${topics.get(0)}`", "run `krelp help` to see the commands");
                    return 1;
                }
                Console.print(topic.help());
            }
            case NEW, INIT -> this.scaffold(command, args, krelp);
            case ADD -> {
                Dependency dependency = this.dependency(args, krelp);
                args.finish(word);
                Edit edit = new Edit(krelp);
                edit.add(dependency);
                edit.save();
            }
            case REMOVE -> {
                boolean dev = args.flag("--dev");
                List<String> names = args.positionals();
                args.finish(word);
                if (names.isEmpty()) {
                    throw new KrelpException("`krelp remove` needs the names of the dependencies to remove");
                }
                Edit edit = new Edit(krelp);
                edit.remove(&names, dev);
                edit.save();
            }
            case UPDATE -> {
                List<String> names = args.positionals();
                args.finish(word);
                Manifest manifest = krelp.manifest();
                for (&String name : &names) {
                    if (!manifest.dependsOn(name)) {
                        this.shell.warn("`${manifest.name()}` does not depend on `$name` directly");
                    }
                }
                krelp.resolve(manifest, &LockOptions.updating(names));
                this.shell.status("Updated", "krelp.lock");
            }
            case TREE -> {
                LockOptions options = LockOptions.keep(args.flag("--locked"));
                args.finish(word);
                Console.print(krelp.load(&options).resolution().tree());
            }
            case PUBLISH -> {
                boolean dryRun = args.flag("--dry-run");
                boolean allowDirty = args.flag("--allow-dirty");
                args.finish(word);
                new Publish(krelp, dryRun, allowDirty).run();
            }
            case CLEAN -> {
                args.finish(word);
                String target = krelp.manifest().targetDir();
                try {
                    Fs.removeAll(target);
                } catch (IOException e) {
                    throw new KrelpException(e.getMessage() ?: "couldn't remove `$target`");
                }
                this.shell.status("Removed", target);
            }
            default -> {}
        }
        return 0;
    }

    private void scaffold(Command command, &mut Args args, &Krelp krelp) throws KrelpException {
        boolean library = args.flag("--lib");
        String? name = args.option("--name");
        List<String> dirs = args.positionals();
        args.finish(command.word());
        String dir = krelp.workingDirectory();
        if (command == Command.NEW) {
            if (dirs.size() != 1) {
                throw new KrelpException("`krelp new` needs the directory to create", "run `krelp new my_app`");
            }
            dir = Fs.resolve(dir, dirs.get(0));
            if (Files.exists(dir)) {
                throw new KrelpException("`${dirs.get(0)}` already exists", "use `krelp init` inside it instead");
            }
        } else if (!dirs.isEmpty()) {
            throw new KrelpException("`krelp init` creates the package in the current directory");
        }
        Scaffold.at(dir, name, library).create(this.shell);
    }

    private Dependency dependency(&mut Args args, &Krelp krelp) throws KrelpException {
        boolean dev = args.flag("--dev");
        String? path = args.option("--path");
        String? git = args.option("--git");
        String? branch = args.option("--branch");
        String? tag = args.option("--tag");
        String? rev = args.option("--rev");
        List<String> specs = args.positionals();
        if (specs.size() != 1) {
            throw new KrelpException(
                "`krelp add` needs the name of one dependency",
                "run `krelp add NAME`, `krelp add NAME --path DIR` or `krelp add NAME --git URL`"
            );
        }
        String spec = specs.get(0);
        String name = spec;
        VersionReq req = VersionReq.any();
        int at = spec.indexOf("@");
        if (at >= 0) {
            name = spec.substring(0, at);
            try {
                req = VersionReq.parse(spec.substring(at + 1));
            } catch (SemverException e) {
                throw new KrelpException(e.getMessage() ?: "invalid version requirement");
            }
        }
        String? problem = Manifest.checkName(name);
        if (problem != null) {
            throw new KrelpException(problem);
        }
        int refs = (branch != null ? 1 : 0) + (tag != null ? 1 : 0) + (rev != null ? 1 : 0);
        if (refs > 0 && git == null) {
            throw new KrelpException("`--branch`, `--tag` and `--rev` need `--git`");
        }
        if (refs > 1) {
            throw new KrelpException("only one of `--branch`, `--tag` and `--rev` can be given");
        }
        if (path != null && git != null) {
            throw new KrelpException("a dependency comes from `--path` or from `--git`, not both");
        }
        if (path != null) {
            String absolute = Fs.resolve(krelp.workingDirectory(), path);
            if (!Files.isDirectory(absolute)) {
                throw new KrelpException("`$path` is not a directory");
            }
            return new Dependency(name, DepKind.Path(Fs.relative(krelp.manifest().dir(), absolute)), req, dev);
        }
        if (git != null) {
            return new Dependency(name, DepKind.Git(git, GitRef.of(branch, tag, rev)), req, dev);
        }
        return new Dependency(name, DepKind.Registry, req, dev);
    }
}
