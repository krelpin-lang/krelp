package tests;

import krelp.toml.TomlException;
import krelp.toml.TomlParser;
import krelp.toml.TomlTable;
import krelp.toml.TomlWriter;
import std.util.List;

class TomlTest {
    static TomlTable parse(String text) {
        try {
            return TomlParser.parse(text, "t.toml");
        } catch (TomlException e) {
            throw new IllegalStateException(e.getMessage() ?: "");
        }
    }

    static String error(String text) {
        try {
            TomlParser.parse(text, "t.toml");
            return "no error";
        } catch (TomlException e) {
            return e.getMessage() ?: "";
        }
    }

    @Test
    static void readsTablesAndValues() throws TomlException {
        TomlTable root = TomlTest.parse(
            "# a comment\n"
            + "title = \"krelp\" # trailing\n"
            + "count = 1_000\n"
            + "hex = 0xff\n"
            + "ratio = 2.5\n"
            + "on = true\n"
            + "list = [\"a\", 'b', \"\"\"c\"\"\"]\n"
            + "\n"
            + "[package]\n"
            + "name = \"app\"\n"
            + "dotted.key = \"x\"\n"
            + "\n"
            + "[dependencies]\n"
            + "util = { path = \"../util\", version = \"1\" }\n"
            + "\"quoted key\" = \"esc\\t\\u00e9\"\n"
        );
        Check.equal(root.requireString("title"), "krelp");
        Check.that(root.integer("count", 0L) == 1000L, "count to be 1000");
        Check.that(root.integer("hex", 0L) == 255L, "hex to be 255");
        Check.that(root.bool("on", false), "on to be true");
        List<String> list = root.strings("list");
        Check.equal(String.join(",", list.get(0), list.get(1), list.get(2)), "a,b,c");
        &TomlTable pkg = root.requireTable("package");
        Check.equal(pkg.requireString("name"), "app");
        Check.equal(pkg.requireTable("dotted").requireString("key"), "x");
        &TomlTable deps = root.requireTable("dependencies");
        Check.equal(deps.requireTable("util").requireString("path"), "../util");
        Check.equal(deps.requireString("quoted key"), "esc\té");
        Check.equal(deps.qualify("quoted key"), "dependencies.\"quoted key\"");
    }

    @Test
    static void readsArraysOfTables() throws TomlException {
        TomlTable root = TomlTest.parse(
            "[[package]]\nname = \"a\"\n\n[[package]]\nname = \"b\"\n[package.extra]\nx = 1\n"
        );
        Check.that(root.array("package")?.size() == 2, "two packages");
        Check.equal(TomlWriter.write(&root),
            "[[package]]\nname = \"a\"\n\n[[package]]\nname = \"b\"\n\n[package.extra]\nx = 1\n");
    }

    @Test
    static void reportsWrongTypes() {
        TomlTable root = TomlTest.parse("[package]\nname = 3\n");
        try {
            root.requireTable("package").requireString("name");
            throw new IllegalStateException("expected an error");
        } catch (TomlException e) {
            Check.equal(e.getMessage() ?: "", "`package.name` must be a string, not an integer");
        }
    }

    @Test
    static void rejectsMalformedDocuments() {
        Check.equal(TomlTest.error("name \"x\""), "t.toml:1:6: expected `=` after the key `name`");
        Check.equal(TomlTest.error("a = 1\na = 2"), "t.toml:2:1: the key `a` is defined twice");
        Check.equal(TomlTest.error("[a]\n[a]"), "t.toml:2:1: the table `[a]` is defined twice");
        Check.equal(TomlTest.error("s = \"open"), "t.toml:1:10: the string is never closed with `\"`");
        Check.equal(TomlTest.error("d = 1979-05-27"), "t.toml:1:5: dates and times are not supported");
    }
}
