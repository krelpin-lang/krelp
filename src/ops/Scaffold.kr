package krelp.ops;

import krelp.manifest.Manifest;
import krelp.source.Repository;
import krelp.util.Fs;
import krelp.util.KrelpException;
import krelp.util.Shell;
import std.io.Files;
import std.io.IOException;
import std.io.Path;

record Scaffold(String dir, String name, boolean library) {
    static Scaffold at(String dir, String? name, boolean library) {
        if (name != null) {
            return new Scaffold(dir, name, library);
        }
        String base = Path.fileName(dir);
        try {
            base = Path.fileName(Files.canonicalPath(dir));
        } catch (IOException e) {}
        return new Scaffold(dir, base.replace("-", "_").toLowerCase(), library);
    }

    void create(Shell shell) throws KrelpException {
        String? problem = Manifest.checkName(this.name);
        if (problem != null) {
            throw new KrelpException(problem, "choose a name like `my_app`, or pass `--name`");
        }
        if (Files.exists(Path.join(this.dir, Manifest.FILE))) {
            throw new KrelpException("`${this.dir}` already holds a package");
        }
        String src = Path.join(this.dir, "src");
        try {
            Fs.write(
                Path.join(this.dir, Manifest.FILE),
                "[package]\nname = \"${this.name}\"\nversion = \"0.1.0\"\n\n[dependencies]\n"
            );
            if (this.library) {
                Fs.write(Path.join(src, "${this.typeName()}.kr"), this.librarySource());
            } else {
                Fs.write(Path.join(src, "Main.kr"), this.programSource());
            }
            String ignore = Path.join(this.dir, ".gitignore");
            if (!Files.exists(ignore)) {
                Fs.write(ignore, "/target\n");
            }
        } catch (IOException e) {
            throw new KrelpException(e.getMessage() ?: "couldn't write the files of `${this.name}`");
        }
        Repository repo = new Repository(this.dir);
        if (!repo.isWorkTree()) {
            repo.tryRun("init", "--quiet");
        }
        shell.status("Created", "${this.library ? "library" : "program"} `${this.name}`");
    }

    private String typeName() {
        StringBuilder out = new StringBuilder();
        boolean upper = true;
        for (char c : this.name.chars()) {
            if (c == '_') {
                upper = true;
            } else if (upper) {
                out.append(String.valueOf(c).toUpperCase());
                upper = false;
            } else {
                out.append(c);
            }
        }
        String type = out.toString();
        return type.isEmpty() || type == "Main" ? "Library" : type;
    }

    private String programSource() {
        return "package ${this.name};\n"
            + "\n"
            + "class Main {\n"
            + "    static void main(String[] args) {\n"
            + "        Console.println(\"Hello, world!\");\n"
            + "    }\n"
            + "}\n";
    }

    private String librarySource() {
        String type = this.typeName();
        return "package ${this.name};\n"
            + "\n"
            + "/** The entry point of the `${this.name}` library. */\n"
            + "final class $type {\n"
            + "    private $type() {}\n"
            + "\n"
            + "    /**\n"
            + "     * Adds two numbers.\n"
            + "     *\n"
            + "     * @param a the first number\n"
            + "     * @param b the second number\n"
            + "     * @return their sum\n"
            + "     */\n"
            + "    static int add(int a, int b) {\n"
            + "        return a + b;\n"
            + "    }\n"
            + "\n"
            + "    @Test\n"
            + "    static void addsNumbers() {\n"
            + "        if ($type.add(2, 2) != 4) {\n"
            + "            throw new IllegalStateException(\"2 + 2 is not 4\");\n"
            + "        }\n"
            + "    }\n"
            + "}\n";
    }
}
