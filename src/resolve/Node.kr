package krelp.resolve;

import krelp.manifest.Dependency;
import krelp.semver.Version;
import krelp.source.SourceId;
import krelp.util.KrelpException;
import std.util.ArrayList;
import std.util.List;

record Node(
    String name,
    Version version,
    SourceId source,
    String? commit,
    String? repository,
    String dir,
    List<Dependency> dependencies
) {
    boolean satisfies(&Demand demand) throws KrelpException {
        if (!this.source.sameAs(&demand.source())) {
            throw new KrelpException(
                "`${demand.from()}` needs `${this.name}` from ${demand.source().origin()}, "
                + "but another package needs it from ${this.source.origin()}",
                "a build holds only one package of each name; make both use the same source"
            );
        }
        return demand.req().matches(&this.version);
    }

    boolean isFetched() {
        return !this.dir.isEmpty();
    }

    Node copy() {
        List<Dependency> deps = new ArrayList<>();
        for (&Dependency dep : this.dependencies) {
            deps.add(dep.copy());
        }
        return new Node(this.name, this.version, this.source, this.commit, this.repository, this.dir, deps);
    }

    List<String> dependencyNames() {
        List<String> names = new ArrayList<>();
        for (&Dependency dep : this.dependencies) {
            names.add(dep.name());
        }
        return names;
    }

    String toString() {
        return "${this.name} v${this.version}";
    }
}
