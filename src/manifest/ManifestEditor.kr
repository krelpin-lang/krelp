package krelp.manifest;

import std.util.ArrayList;
import std.util.List;

final class ManifestEditor {
    private final List<ManifestLine> lines;

    ManifestEditor(String text) {
        this.lines = new ArrayList<>();
        for (String line : text.lines()) {
            this.lines.add(new ManifestLine(line));
        }
    }

    mut void set(String section, String name, String value) {
        this.remove(section, name);
        String entry = "$name = $value";
        int header = this.findHeader("[$section]");
        if (header < 0) {
            if (!this.lines.isEmpty() && !this.lines.get(this.lines.size() - 1).isBlank()) {
                this.lines.add(new ManifestLine(""));
            }
            this.lines.add(new ManifestLine("[$section]"));
            this.lines.add(new ManifestLine(entry));
            return;
        }
        int end = this.sectionEnd(header);
        int insert = end;
        while (insert > header + 1 && this.lines.get(insert - 1).isFiller()) {
            insert--;
        }
        this.lines.add(insert, new ManifestLine(entry));
    }

    mut boolean remove(String section, String name) {
        boolean removed = false;
        int table = this.findHeader("[$section.$name]");
        if (table >= 0) {
            int end = this.sectionEnd(table);
            for (int i = end - 1; i >= table; i--) {
                this.lines.remove(i);
            }
            removed = true;
        }
        int header = this.findHeader("[$section]");
        if (header < 0) {
            return removed;
        }
        int i = header + 1;
        while (i < this.sectionEnd(header)) {
            if (this.lines.get(i).key() == name) {
                this.lines.remove(i);
                removed = true;
            } else {
                i++;
            }
        }
        return removed;
    }

    String text() {
        StringBuilder out = new StringBuilder();
        for (&ManifestLine line : this.lines) {
            out.append(line.text());
            out.append('\n');
        }
        return out.toString();
    }

    private int findHeader(String header) {
        for (int i = 0; i < this.lines.size(); i++) {
            if (this.lines.get(i).header() == header) {
                return i;
            }
        }
        return -1;
    }

    private int sectionEnd(int header) {
        for (int i = header + 1; i < this.lines.size(); i++) {
            if (this.lines.get(i).startsSection()) {
                return i;
            }
        }
        return this.lines.size();
    }
}
