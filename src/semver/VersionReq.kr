package krelp.semver;

import std.util.ArrayList;
import std.util.List;

final class VersionReq {
    private String text;
    private List<Bound> bounds;

    private VersionReq(String text, List<Bound> bounds) {
        this.text = text;
        this.bounds = bounds;
    }

    static VersionReq any() {
        return new VersionReq("*", new ArrayList<>());
    }

    static VersionReq exact(&Version version) {
        List<Bound> bounds = new ArrayList<>();
        bounds.add(new Bound(Op.EXACT, version));
        return new VersionReq("=$version", bounds);
    }

    static VersionReq parse(String text) throws SemverException {
        String trimmed = text.trim();
        if (trimmed.isEmpty()) {
            throw new SemverException("the version requirement is empty; use `*` to accept any version");
        }
        List<Bound> bounds = new ArrayList<>();
        for (String part : trimmed.split(",")) {
            VersionReq.condition(part.trim(), text, &mut bounds);
        }
        return new VersionReq(trimmed, bounds);
    }

    VersionReq copy() {
        List<Bound> bounds = new ArrayList<>();
        for (Bound bound : this.bounds) {
            bounds.add(bound);
        }
        return new VersionReq(this.text, bounds);
    }

    boolean matches(&Version version) {
        for (&Bound bound : this.bounds) {
            if (!bound.matches(version)) {
                return false;
            }
        }
        if (!version.isPrerelease()) {
            return true;
        }
        for (&Bound bound : this.bounds) {
            if (bound.version().isPrerelease() && bound.version().sameRelease(version)) {
                return true;
            }
        }
        return false;
    }

    &List<Bound> bounds() {
        return &this.bounds;
    }

    String toString() {
        return this.text;
    }

    private static void condition(String part, String text, &mut List<Bound> bounds) throws SemverException {
        if (part.isEmpty()) {
            throw new SemverException("`$text` has an empty condition between commas");
        }
        String rest = part;
        String op = "^";
        String[] prefixes = {">=", "<=", ">", "<", "=", "^", "~"};
        for (String prefix : prefixes) {
            String? stripped = part.stripPrefix(prefix);
            if (stripped != null) {
                op = prefix;
                rest = stripped.trim();
                break;
            }
        }
        if (rest == "*") {
            if (op != "^") {
                throw new SemverException("`$text` combines `$op` with `*`");
            }
            return;
        }
        Partial partial = Partial.parse(rest, text);
        if (partial.wildcard() && op != "^") {
            throw new SemverException("`$text` combines `$op` with a wildcard");
        }
        if (op == "^") {
            if (partial.wildcard()) {
                VersionReq.range(bounds, partial.lower(), partial.bumpLast());
            } else {
                VersionReq.range(bounds, partial.lower(), partial.caretUpper());
            }
        } else if (op == "~") {
            VersionReq.range(bounds, partial.lower(), partial.tildeUpper());
        } else if (op == "=") {
            if (partial.complete()) {
                bounds.add(new Bound(Op.EXACT, partial.lower()));
            } else {
                VersionReq.range(bounds, partial.lower(), partial.bumpLast());
            }
        } else if (op == ">=") {
            bounds.add(new Bound(Op.GREATER_EQ, partial.lower()));
        } else if (op == ">") {
            if (partial.complete()) {
                bounds.add(new Bound(Op.GREATER, partial.lower()));
            } else {
                bounds.add(new Bound(Op.GREATER_EQ, partial.bumpLast()));
            }
        } else if (op == "<") {
            bounds.add(new Bound(Op.LESS, partial.lower()));
        } else {
            if (partial.complete()) {
                bounds.add(new Bound(Op.LESS_EQ, partial.lower()));
            } else {
                bounds.add(new Bound(Op.LESS, partial.bumpLast()));
            }
        }
    }

    private static void range(&mut List<Bound> bounds, Version lower, Version upper) {
        bounds.add(new Bound(Op.GREATER_EQ, lower));
        bounds.add(new Bound(Op.LESS, upper));
    }
}
