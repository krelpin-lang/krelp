package krelp.resolve;

import krelp.lock.LockedPackage;
import krelp.lock.Lockfile;
import krelp.manifest.Dependency;
import krelp.manifest.GitRef;
import krelp.manifest.Manifest;
import krelp.semver.Version;
import krelp.source.IndexEntry;
import krelp.source.SourceId;
import krelp.source.Sources;
import krelp.util.KrelpException;
import krelp.util.Shell;
import std.util.ArrayList;
import std.util.List;

final class Resolver borrows sources {
    private static int ROUNDS = 32;

    private &mut Sources sources;
    private Shell shell;
    private Lockfile? lock;
    private boolean unlockAll;
    private List<String> unlocked;
    private List<Demand> hints;

    Resolver(&mut Sources sources, Shell shell, Lockfile? lock, boolean unlockAll, &List<String> unlocked)
        keeps sources {
        this.sources = sources;
        this.shell = shell;
        this.lock = lock;
        this.unlockAll = unlockAll;
        this.unlocked = new ArrayList<>();
        for (&String name : unlocked) {
            this.unlocked.add(name);
        }
        this.hints = new ArrayList<>();
    }

    mut Resolution resolve(&Manifest root) throws KrelpException {
        for (int round = 0; round < Resolver.ROUNDS; round++) {
            List<Demand> demands = new ArrayList<>();
            List<Dependency> rootDeps = new ArrayList<>();
            for (&Dependency dep : root.dependencies()) {
                rootDeps.add(dep.copy());
            }
            this.demand(&mut demands, root.name(), root.dir(), &rootDeps);
            Resolution graph = new Resolution(new Node(
                root.name(), root.version(), SourceId.Root, null, null, root.dir(), rootDeps
            ));
            boolean settled = true;
            for (int next = 0; next < demands.size(); next++) {
                String name = demands.get(next).name();
                if (name == root.name()) {
                    throw new KrelpException(
                        "`${demands.get(next).from()}` depends on `$name`, the package being built",
                        "a package cannot depend on itself, even through other packages"
                    );
                }
                (&Node)? found = graph.find(&name);
                if (found != null) {
                    settled = found.satisfies(demands.get(next)) && settled;
                    continue;
                }
                Node node = this.choose(Requirements.of(&name, &demands, &this.hints));
                this.demand(&mut demands, name, node.dir(), node.dependencies());
                graph.add(node);
            }
            if (settled) {
                return graph;
            }
            this.hints = demands;
        }
        throw new KrelpException("the dependencies could not be resolved after ${Resolver.ROUNDS} attempts");
    }

    private void demand(&mut List<Demand> demands, String from, String dir, &List<Dependency> deps)
        throws KrelpException {
        String registry = this.sources.registry();
        for (&Dependency dep : deps) {
            demands.add(new Demand(from, dep.name(), dep.sourceFrom(from, dir, registry), dep.req().copy()));
        }
    }

    private mut Node choose(Requirements wanted) throws KrelpException {
        return switch (wanted.source()) {
            case Path(String dir) -> this.local(&wanted, dir, null);
            case Git(String url, GitRef ref) -> this.git(&wanted, url, &ref);
            case Registry(String index) -> this.registry(&wanted);
            case Root -> throw new KrelpException("`${wanted.name()}` cannot be the root package");
        };
    }

    private mut Node git(&Requirements wanted, String url, &GitRef ref) throws KrelpException {
        (&LockedPackage)? locked = this.locked(wanted);
        String? pinned = locked != null ? locked.commit() : null;
        boolean refresh = this.unlocking(&wanted.name());
        String commit = pinned ?: this.sources.git().resolve(url, ref, refresh);
        String dir = this.sources.git().checkout(url, commit);
        return this.local(wanted, dir, commit);
    }

    private Node local(&Requirements wanted, String dir, String? commit) throws KrelpException {
        Manifest manifest = Manifest.read(dir, this.shell);
        wanted.checkLocal(&manifest, &dir);
        List<Dependency> deps = new ArrayList<>();
        for (&Dependency dep : manifest.dependencies()) {
            if (!dep.dev()) {
                deps.add(dep.copy());
            }
        }
        return new Node(wanted.name(), manifest.version(), wanted.source(), commit, null, dir, deps);
    }

    private mut Node registry(&Requirements wanted) throws KrelpException {
        (&LockedPackage)? locked = this.locked(wanted);
        Version? preferred = locked != null ? locked.version() : null;
        if (preferred == null) {
            this.sources.index().update();
        }
        List<IndexEntry> entries = this.sources.index().versions(wanted.name());
        int pick = wanted.pick(&entries, preferred);
        if (pick < 0 && !this.sources.index().isFresh()) {
            this.sources.index().update();
            entries = this.sources.index().versions(wanted.name());
            pick = wanted.pick(&entries, preferred);
        }
        if (pick < 0) {
            throw wanted.unmet(&entries);
        }
        &IndexEntry entry = entries.get(pick);
        List<Dependency> deps = new ArrayList<>();
        for (&Dependency dep : entry.dependencies()) {
            deps.add(dep.copy());
        }
        return new Node(wanted.name(), entry.version(), wanted.source(), entry.rev(), entry.git(), "", deps);
    }

    private (&LockedPackage)? locked(&Requirements wanted) {
        if (this.unlocking(&wanted.name())) {
            return null;
        }
        return this.lock?.findFrom(&wanted.name(), &wanted.source());
    }

    private boolean unlocking(&String name) {
        return this.unlockAll || this.unlocked.contains(name);
    }
}
