package krelp.ops;

import krelp.manifest.Manifest;
import krelp.resolve.Node;
import krelp.resolve.Resolution;
import krelp.util.KrelpException;
import std.io.Files;
import std.io.IOException;
import std.io.Path;

record Project(Manifest manifest, Resolution resolution) {
    String targetDir(String name) throws KrelpException {
        String dir = Path.join(this.manifest.targetDir(), name);
        try {
            Files.createDirectories(dir);
        } catch (IOException e) {
            throw new KrelpException(e.getMessage() ?: "couldn't create `$dir`");
        }
        return dir;
    }

    String describe(String name) {
        (&Node)? node = this.resolution.find(&name);
        return node == null ? name : node.toString();
    }

    String shown(String path) {
        return path.stripPrefix("${this.manifest.dir()}/") ?: path;
    }
}
