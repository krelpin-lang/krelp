package krelp.util;

record Shell(boolean quiet) {
    void status(String verb, String subject) {
        if (this.quiet) {
            return;
        }
        Console.eprintln("${verb:>12} $subject");
    }

    void warn(String message) {
        Console.eprintln("warning: $message");
    }

    void error(String message, String? help) {
        Console.eprintln("error: $message");
        if (help != null) {
            Console.eprintln("  help: $help");
        }
    }
}
