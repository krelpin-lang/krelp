package krelp.source;

import krelp.manifest.GitRef;
import krelp.util.Fs;
import krelp.util.KrelpException;
import krelp.util.Shell;
import std.io.Files;
import std.io.IOException;
import std.io.Path;
import std.process.Command;
import std.process.Output;
import std.sync.Mutex;
import std.sync.MutexGuard;
import std.util.ArrayList;
import std.util.List;

final class Git {
    private static Mutex<List<String>> FETCHED = new Mutex<>(new ArrayList<>());

    private Git() {}

    static String resolve(String url, &GitRef ref, boolean refresh) throws KrelpException {
        String db = Git.mirror(url, refresh);
        String revision = "${ref.revision()}^{commit}";
        String? commit = Git.tryRun(db, "rev-parse", "--verify", "--quiet", revision);
        if (commit == null && !Git.wasFetched(url)) {
            Git.fetch(url, db);
            commit = Git.tryRun(db, "rev-parse", "--verify", "--quiet", revision);
        }
        if (commit == null) {
            throw new KrelpException("`$url` has no $ref");
        }
        return commit.trim();
    }

    static String checkout(String url, String commit) throws KrelpException {
        String dir = Home.checkout(url, commit);
        String done = Git.marker(dir);
        if (Files.isFile(done)) {
            return dir;
        }
        String db = Git.mirror(url, false);
        if (Git.tryRun(db, "cat-file", "-e", "$commit^{commit}") == null) {
            Git.fetch(url, db);
            if (Git.tryRun(db, "cat-file", "-e", "$commit^{commit}") == null) {
                throw new KrelpException("`$url` has no commit `$commit`");
            }
        }
        try {
            Fs.removeAll(dir);
        } catch (IOException e) {
            throw new KrelpException(e.getMessage() ?: "couldn't clear `$dir`");
        }
        Git.run("", "clone", "--quiet", "--no-checkout", db, dir);
        Git.run(dir, "checkout", "--quiet", "--detach", commit);
        try {
            Files.writeString(done, "");
        } catch (IOException e) {
            throw new KrelpException(e.getMessage() ?: "couldn't write `$done`");
        }
        return dir;
    }

    static boolean isCheckedOut(String url, String commit) {
        return Files.isFile(Git.marker(Home.checkout(url, commit)));
    }

    private static String marker(String dir) {
        return Path.join(dir, ".krelp-ok");
    }

    static String run(String dir, String... args) throws KrelpException {
        Command command = Git.command(dir, &args);
        Output output;
        try {
            output = command.output();
        } catch (IOException e) {
            throw new KrelpException(
                "couldn't run git: ${e.getMessage() ?: ""}",
                "krelp needs git to fetch dependencies; install it and make sure it is on the PATH"
            );
        }
        if (!output.success()) {
            String message = output.stderr().trim();
            throw new KrelpException("`$command` failed${message.isEmpty() ? "" : ":\n$message"}");
        }
        return output.stdout();
    }

    static String? tryRun(String dir, String... args) {
        Command command = Git.command(dir, &args);
        try {
            Output output = command.output();
            return output.success() ? output.stdout() : null;
        } catch (IOException e) {
            return null;
        }
    }

    private static String mirror(String url, boolean refresh) throws KrelpException {
        String db = Home.gitDb(url);
        if (!Files.isDirectory(db)) {
            Shell.status("Fetching", url);
            try {
                Files.createDirectories(Path.parent(db));
            } catch (IOException e) {
                throw new KrelpException(e.getMessage() ?: "couldn't create `$db`");
            }
            Git.run("", "clone", "--quiet", "--mirror", url, db);
            Git.markFetched(url);
        } else if (refresh && !Git.wasFetched(url)) {
            Git.fetch(url, db);
        }
        return db;
    }

    private static void fetch(String url, String db) throws KrelpException {
        Shell.status("Updating", url);
        Git.run(db, "fetch", "--quiet", "--prune", "--tags", "origin", "+refs/heads/*:refs/heads/*");
        Git.markFetched(url);
    }

    private static void markFetched(String url) {
        MutexGuard<List<String>> guard = Git.FETCHED.lock();
        guard.getMut().add(url);
    }

    private static boolean wasFetched(String url) {
        MutexGuard<List<String>> guard = Git.FETCHED.lock();
        for (&String fetched : guard.get()) {
            if (fetched == url) {
                return true;
            }
        }
        return false;
    }

    private static Command command(String dir, &String[] args) {
        Command command = new Command("git");
        if (!dir.isEmpty()) {
            command.args("-C", dir);
        }
        for (int i = 0; i < args.length; i++) {
            command.arg(args[i]);
        }
        command.env("GIT_TERMINAL_PROMPT", "0");
        return command;
    }
}
