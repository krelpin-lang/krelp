package krelp.cli;

import krelp.build.Profile;
import krelp.manifest.DepKind;
import krelp.manifest.Dependency;
import krelp.manifest.GitRef;
import krelp.manifest.Manifest;
import krelp.ops.Builder;
import krelp.ops.Edit;
import krelp.ops.LockOptions;
import krelp.ops.Project;
import krelp.ops.Publish;
import krelp.ops.Scaffold;
import krelp.semver.SemverException;
import krelp.semver.VersionReq;
import krelp.util.Fs;
import krelp.util.KrelpException;
import krelp.util.Shell;
import std.io.Files;
import std.io.IOException;
import std.io.Path;
import std.util.ArrayList;
import std.util.List;

final class Cli {
    public static String VERSION = "0.1.0";

    private Cli() {}

    static int main(&String[] argv) {
        int first = 0;
        while (first < argv.length && argv[first].startsWith("-")) {
            String option = argv[first];
            if (option == "-q" || option == "--quiet") {
                Shell.setQuiet(true);
            } else if (option == "-V" || option == "--version") {
                Console.println("krelp ${Cli.VERSION}");
                return 0;
            } else if (option == "-h" || option == "--help") {
                Console.print(Help.overview());
                return 0;
            } else {
                Shell.error("krelp has no option `$option`", "run `krelp help` to see the options");
                return 2;
            }
            first++;
        }
        if (first >= argv.length) {
            Console.print(Help.overview());
            return 2;
        }
        String command = argv[first];
        Args args = new Args(argv, first + 1);
        try {
            if (args.flag("-h", "--help")) {
                return Cli.help(command);
            }
            return Cli.dispatch(command, args);
        } catch (KrelpException e) {
            Shell.error(e.getMessage() ?: "krelp failed", e.help());
            return 1;
        }
    }

    private static int dispatch(String command, Args args) throws KrelpException {
        if (command == "help") {
            List<String> topics = args.positionals();
            args.finish(command);
            return topics.isEmpty() ? Cli.help("") : Cli.help(topics.get(0));
        }
        if (command == "new" || command == "init") {
            boolean library = args.flag("--lib");
            String? name = args.option("--name");
            List<String> dirs = args.positionals();
            args.finish(command);
            String dir;
            if (command == "new") {
                if (dirs.size() != 1) {
                    throw new KrelpException("`krelp new` needs the directory to create", "run `krelp new my_app`");
                }
                dir = Fs.resolve(System.workingDirectory(), dirs.get(0));
                if (Files.exists(dir)) {
                    throw new KrelpException("`${dirs.get(0)}` already exists", "use `krelp init` inside it instead");
                }
            } else {
                if (!dirs.isEmpty()) {
                    throw new KrelpException("`krelp init` creates the package in the current directory");
                }
                dir = System.workingDirectory();
            }
            Scaffold.create(dir, name ?: Scaffold.nameOf(dir), library);
            return 0;
        }
        if (command == "build" || command == "check" || command == "run" || command == "test") {
            Profile profile = args.flag("--release", "-r") ? Profile.RELEASE : Profile.DEBUG;
            LockOptions options = new LockOptions(args.flag("--locked"), false, new ArrayList<>());
            args.finish(command);
            Project project = Project.load(&options);
            if (command == "build") {
                Builder.build(&project, profile);
            } else if (command == "check") {
                Builder.check(&project, profile);
            } else if (command == "run") {
                return Builder.run(&project, profile, args.passthrough());
            } else {
                Builder.test(&project, profile);
            }
            return 0;
        }
        if (command == "add") {
            Dependency dependency = Cli.dependency(&mut args);
            args.finish(command);
            Edit.add(Project.find(), dependency);
            return 0;
        }
        if (command == "remove") {
            boolean dev = args.flag("--dev");
            List<String> names = args.positionals();
            args.finish(command);
            if (names.isEmpty()) {
                throw new KrelpException("`krelp remove` needs the names of the dependencies to remove");
            }
            Edit.remove(Project.find(), &names, dev);
            return 0;
        }
        if (command == "update") {
            List<String> names = args.positionals();
            args.finish(command);
            Manifest manifest = Project.find();
            for (&String name : &names) {
                boolean known = false;
                for (&Dependency dep : manifest.dependencies()) {
                    known = known || dep.name() == name;
                }
                if (!known) {
                    Shell.warn("`${manifest.name()}` does not depend on `$name` directly");
                }
            }
            Project.resolve(manifest, &new LockOptions(false, names.isEmpty(), names));
            Shell.status("Updated", "krelp.lock");
            return 0;
        }
        if (command == "tree") {
            LockOptions options = new LockOptions(args.flag("--locked"), false, new ArrayList<>());
            args.finish(command);
            Project project = Project.load(&options);
            Console.print(project.resolution().tree());
            return 0;
        }
        if (command == "publish") {
            boolean dryRun = args.flag("--dry-run");
            boolean allowDirty = args.flag("--allow-dirty");
            args.finish(command);
            Publish.run(dryRun, allowDirty);
            return 0;
        }
        if (command == "clean") {
            args.finish(command);
            Manifest manifest = Project.find();
            String target = Path.join(manifest.dir(), "target");
            try {
                Fs.removeAll(target);
            } catch (IOException e) {
                throw new KrelpException(e.getMessage() ?: "couldn't remove `$target`");
            }
            Shell.status("Removed", target);
            return 0;
        }
        throw new KrelpException("krelp has no command `$command`", "run `krelp help` to see the commands");
    }

    private static int help(String command) {
        if (command.isEmpty()) {
            Console.print(Help.overview());
            return 0;
        }
        String? text = Help.of(command);
        if (text == null) {
            Shell.error("krelp has no command `$command`", "run `krelp help` to see the commands");
            return 1;
        }
        Console.print(text);
        return 0;
    }

    private static Dependency dependency(&mut Args args) throws KrelpException {
        boolean dev = args.flag("--dev");
        String? path = args.option("--path");
        String? git = args.option("--git");
        String? branch = args.option("--branch");
        String? tag = args.option("--tag");
        String? rev = args.option("--rev");
        List<String> specs = args.positionals();
        if (specs.size() != 1) {
            throw new KrelpException(
                "`krelp add` needs the name of one dependency",
                "run `krelp add NAME`, `krelp add NAME --path DIR` or `krelp add NAME --git URL`"
            );
        }
        String spec = specs.get(0);
        String name = spec;
        VersionReq req = VersionReq.any();
        int at = spec.indexOf("@");
        if (at >= 0) {
            name = spec.substring(0, at);
            try {
                req = VersionReq.parse(spec.substring(at + 1));
            } catch (SemverException e) {
                throw new KrelpException(e.getMessage() ?: "invalid version requirement");
            }
        }
        String? problem = Manifest.checkName(name);
        if (problem != null) {
            throw new KrelpException(problem);
        }
        int refs = (branch != null ? 1 : 0) + (tag != null ? 1 : 0) + (rev != null ? 1 : 0);
        if (refs > 0 && git == null) {
            throw new KrelpException("`--branch`, `--tag` and `--rev` need `--git`");
        }
        if (refs > 1) {
            throw new KrelpException("only one of `--branch`, `--tag` and `--rev` can be given");
        }
        if (path != null && git != null) {
            throw new KrelpException("a dependency comes from `--path` or from `--git`, not both");
        }
        if (path != null) {
            Manifest manifest = Project.find();
            String absolute = Fs.resolve(System.workingDirectory(), path);
            if (!Files.isDirectory(absolute)) {
                throw new KrelpException("`$path` is not a directory");
            }
            return new Dependency(name, DepKind.Path(Fs.relative(manifest.dir(), absolute)), req, dev);
        }
        if (git != null) {
            GitRef ref = GitRef.DefaultBranch;
            if (branch != null) {
                ref = GitRef.Branch(branch);
            } else if (tag != null) {
                ref = GitRef.Tag(tag);
            } else if (rev != null) {
                ref = GitRef.Rev(rev);
            }
            return new Dependency(name, DepKind.Git(git, ref), req, dev);
        }
        return new Dependency(name, DepKind.Registry, req, dev);
    }
}
