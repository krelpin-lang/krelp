package krelp.semver;

import std.util.ArrayList;
import std.util.List;

final class VersionReq {
    private final String text;
    private final List<Bound> bounds;

    private VersionReq(String text, List<Bound> bounds) {
        this.text = text;
        this.bounds = bounds;
    }

    static VersionReq any() {
        return new VersionReq("*", new ArrayList<>());
    }

    static VersionReq exact(&Version version) {
        List<Bound> bounds = new ArrayList<>();
        bounds.add(new Bound(Op.EXACT, version));
        return new VersionReq("=$version", bounds);
    }

    static VersionReq parse(String text) throws SemverException {
        String trimmed = text.trim();
        if (trimmed.isEmpty()) {
            throw new SemverException("the version requirement is empty; use `*` to accept any version");
        }
        String[] prefixes = {">=", "<=", ">", "<", "=", "^", "~"};
        List<Bound> bounds = new ArrayList<>();
        for (String condition : trimmed.split(",")) {
            String part = condition.trim();
            if (part.isEmpty()) {
                throw new SemverException("`$text` has an empty condition between commas");
            }
            String op = "^";
            String rest = part;
            for (String prefix : prefixes) {
                String? stripped = part.stripPrefix(prefix);
                if (stripped != null) {
                    op = prefix;
                    rest = stripped.trim();
                    break;
                }
            }
            if (rest == "*") {
                if (op != "^") {
                    throw new SemverException("`$text` combines `$op` with `*`");
                }
                continue;
            }
            for (Bound bound : Partial.parse(rest, text).bounds(op, text)) {
                bounds.add(bound);
            }
        }
        return new VersionReq(trimmed, bounds);
    }

    VersionReq copy() {
        List<Bound> bounds = new ArrayList<>();
        for (Bound bound : this.bounds) {
            bounds.add(bound);
        }
        return new VersionReq(this.text, bounds);
    }

    boolean matches(&Version version) {
        for (&Bound bound : this.bounds) {
            if (!bound.matches(version)) {
                return false;
            }
        }
        if (!version.isPrerelease()) {
            return true;
        }
        for (&Bound bound : this.bounds) {
            if (bound.version().isPrerelease() && bound.version().sameRelease(version)) {
                return true;
            }
        }
        return false;
    }

    boolean acceptsAny() {
        return this.bounds.isEmpty();
    }

    String toString() {
        return this.text;
    }
}
