package krelp.source;

import krelp.util.Shell;

final class Sources {
    private Index index;
    private GitCache git;

    Sources(String registry, Home home, Shell shell) {
        this.index = new Index(registry, home, shell);
        this.git = new GitCache(home, shell);
    }

    mut &mut Index index() {
        return &mut this.index;
    }

    mut &mut GitCache git() {
        return &mut this.git;
    }

    String registry() {
        return this.index.url();
    }
}
