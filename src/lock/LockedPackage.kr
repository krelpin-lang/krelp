package krelp.lock;

import krelp.semver.SemverException;
import krelp.semver.Version;
import krelp.source.Repository;
import krelp.source.SourceId;
import krelp.toml.TomlException;
import krelp.toml.TomlTable;
import krelp.toml.TomlWriter;
import krelp.util.KrelpException;
import std.util.List;

record LockedPackage(String name, Version version, SourceId source, String? commit, List<String> dependencies) {
    static LockedPackage fromToml(&TomlTable table, String file) throws TomlException, KrelpException {
        String name = table.requireString("name");
        Version version;
        try {
            version = Version.parse(table.requireString("version"));
        } catch (SemverException e) {
            throw new KrelpException("$file: `$name`: ${e.getMessage() ?: ""}");
        }
        String? commit = table.string("commit");
        if (commit != null && !Repository.isCommitHash(&commit)) {
            throw new KrelpException(
                "$file: `$name` has `commit = \"$commit\"`, which is not a full commit hash",
                "delete it to have krelp write a new one"
            );
        }
        return new LockedPackage(
            name,
            version,
            SourceId.parse(table.requireString("source")),
            commit,
            table.strings("dependencies")
        );
    }

    String toToml() {
        StringBuilder out = new StringBuilder();
        out.appendLine("[[package]]");
        out.appendLine("name = ${TomlWriter.string(this.name)}");
        out.appendLine("version = ${TomlWriter.string(this.version.toString())}");
        out.appendLine("source = ${TomlWriter.string(this.source.key())}");
        String? commit = this.commit;
        if (commit != null) {
            out.appendLine("commit = ${TomlWriter.string(commit)}");
        }
        if (!this.dependencies.isEmpty()) {
            StringBuilder deps = new StringBuilder();
            for (&String dep : this.dependencies) {
                if (!deps.isEmpty()) {
                    deps.append(", ");
                }
                deps.append(TomlWriter.string(dep));
            }
            out.appendLine("dependencies = [$deps]");
        }
        return out.toString();
    }
}
