package krelp.util;

import std.io.Files;
import std.io.IOException;
import std.io.Path;

final class Fs {
    private Fs() {}

    static void removeAll(String path) throws IOException {
        if (!Files.exists(path)) {
            return;
        }
        if (Files.isDirectory(path) && !Fs.isLink(path)) {
            for (String name : Files.list(path)) {
                Fs.removeAll(Path.join(path, name));
            }
        }
        Files.delete(path);
    }

    static void write(String path, String text) throws IOException {
        String parent = Path.parent(path);
        if (!parent.isEmpty()) {
            Files.createDirectories(parent);
        }
        Files.writeString(path, text);
    }

    static String resolve(String base, String path) {
        String joined = Path.join(base, path);
        try {
            return Files.canonicalPath(joined);
        } catch (IOException e) {
            return joined;
        }
    }

    static String relative(String from, String to) {
        String[] base = Fs.parts(from);
        String[] target = Fs.parts(to);
        int shared = 0;
        while (shared < base.length && shared < target.length && base[shared] == target[shared]) {
            shared++;
        }
        StringBuilder out = new StringBuilder();
        for (int i = shared; i < base.length; i++) {
            if (!out.isEmpty()) {
                out.append("/");
            }
            out.append("..");
        }
        for (int i = shared; i < target.length; i++) {
            if (!out.isEmpty()) {
                out.append("/");
            }
            out.append(target[i]);
        }
        return out.isEmpty() ? "." : out.toString();
    }

    private static String[] parts(String path) {
        String trimmed = path;
        while (trimmed.startsWith("/")) {
            trimmed = trimmed.substring(1);
        }
        while (trimmed.endsWith("/")) {
            trimmed = trimmed.substring(0, trimmed.length() - 1);
        }
        if (trimmed.isEmpty()) {
            return new String[0];
        }
        return trimmed.split("/");
    }

    private static boolean isLink(String path) {
        try {
            String parent = Path.parent(path);
            String expected = Path.join(Files.canonicalPath(parent.isEmpty() ? "." : parent), Path.fileName(path));
            return Files.canonicalPath(path) != expected;
        } catch (IOException e) {
            return false;
        }
    }
}
