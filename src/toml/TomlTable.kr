package krelp.toml;

import std.util.ArrayList;
import std.util.HashMap;
import std.util.List;
import std.util.Map;

final class TomlTable {
    private String path;
    private final List<String> order;
    private final Map<String, TomlValue> values;
    private boolean defined;
    private boolean inline;

    TomlTable() {
        this.path = "";
        this.order = new ArrayList<>();
        this.values = new HashMap<>();
        this.defined = false;
        this.inline = false;
    }

    TomlTable(String path) {
        this.path = path;
        this.order = new ArrayList<>();
        this.values = new HashMap<>();
        this.defined = false;
        this.inline = false;
    }

    String path() {
        return this.path;
    }

    mut void setPath(String path) {
        this.path = path;
    }

    String qualify(String key) {
        String shown = TomlWriter.key(key);
        return this.path.isEmpty() ? shown : "${this.path}.$shown";
    }

    &List<String> keys() {
        return &this.order;
    }

    int size() {
        return this.order.size();
    }

    boolean contains(&String key) {
        return this.values.containsKey(key);
    }

    (&TomlValue)? get(&String key) {
        return this.values.get(key);
    }

    mut (&mut TomlValue)? getMut(&String key) {
        return this.values.getMut(key);
    }

    mut void put(String key, TomlValue value) {
        if (!this.values.containsKey(&key)) {
            this.order.add(key);
        }
        this.values.put(key, value);
    }

    mut TomlValue? remove(&String key) {
        int index = this.order.indexOf(key);
        if (index >= 0) {
            this.order.remove(index);
        }
        return this.values.remove(key);
    }

    String? string(String key) throws TomlException {
        (&TomlValue)? value = this.values.get(&key);
        if (value == null) {
            return null;
        }
        return switch (value) {
            case Text(String text) -> text;
            default -> throw this.wrongType(key, "a string", value);
        };
    }

    String requireString(String key) throws TomlException {
        String? value = this.string(key);
        if (value == null) {
            throw new TomlException("`${this.qualify(key)}` is missing");
        }
        return value;
    }

    boolean bool(String key, boolean fallback) throws TomlException {
        (&TomlValue)? value = this.values.get(&key);
        if (value == null) {
            return fallback;
        }
        return switch (value) {
            case Bool(boolean flag) -> flag;
            default -> throw this.wrongType(key, "a boolean", value);
        };
    }

    long integer(String key, long fallback) throws TomlException {
        (&TomlValue)? value = this.values.get(&key);
        if (value == null) {
            return fallback;
        }
        return switch (value) {
            case Integer(long number) -> number;
            default -> throw this.wrongType(key, "an integer", value);
        };
    }

    (&TomlTable)? table(String key) throws TomlException {
        (&TomlValue)? value = this.values.get(&key);
        if (value == null) {
            return null;
        }
        return switch (value) {
            case Table(TomlTable table) -> &table;
            default -> throw this.wrongType(key, "a table", value);
        };
    }

    &TomlTable requireTable(String key) throws TomlException {
        (&TomlTable)? table = this.table(key);
        if (table == null) {
            throw new TomlException("the table `[${this.qualify(key)}]` is missing");
        }
        return table;
    }

    (&List<TomlValue>)? array(String key) throws TomlException {
        (&TomlValue)? value = this.values.get(&key);
        if (value == null) {
            return null;
        }
        return switch (value) {
            case Array(List<TomlValue> items) -> &items;
            default -> throw this.wrongType(key, "an array", value);
        };
    }

    List<String> strings(String key) throws TomlException {
        List<String> result = new ArrayList<>();
        (&List<TomlValue>)? items = this.array(key);
        if (items == null) {
            return result;
        }
        for (&TomlValue item : items) {
            String? text = switch (item) {
                case Text(String value) -> value;
                default -> null;
            };
            if (text == null) {
                throw new TomlException("`${this.qualify(key)}` must be an array of strings");
            }
            result.add(text);
        }
        return result;
    }

    List<String> unknownKeys(String... known) {
        List<String> unknown = new ArrayList<>();
        for (&String key : this.order) {
            boolean found = false;
            for (int i = 0; i < known.length; i++) {
                if (known[i] == key) {
                    found = true;
                }
            }
            if (!found) {
                unknown.add(this.qualify(key));
            }
        }
        return unknown;
    }

    boolean isDefined() {
        return this.defined;
    }

    mut void markDefined() {
        this.defined = true;
    }

    boolean isInline() {
        return this.inline;
    }

    mut void markInline() {
        this.inline = true;
    }

    String toToml() {
        StringBuilder out = new StringBuilder();
        this.writeSection(&mut out, "");
        return out.toString();
    }

    String toInlineToml() {
        if (this.order.isEmpty()) {
            return "{}";
        }
        StringBuilder text = new StringBuilder();
        text.append("{ ");
        boolean first = true;
        for (&String key : this.order) {
            (&TomlValue)? value = this.values.get(key);
            if (value == null) {
                continue;
            }
            if (!first) {
                text.append(", ");
            }
            first = false;
            text.append("${TomlWriter.key(key)} = ${value.toToml()}");
        }
        text.append(" }");
        return text.toString();
    }

    mut String? defineTable(&List<String> path) {
        (&mut TomlTable)? table = this.walk(path, path.size(), true);
        if (table == null) {
            return "`[#]` cannot be defined here, because a key in its path is not a table";
        }
        if (table.isDefined()) {
            return "the table `[#]` is defined twice";
        }
        if (table.isInline()) {
            return "the table `[#]` was written inline and cannot be extended";
        }
        table.markDefined();
        return null;
    }

    mut String? appendTable(&List<String> path) {
        (&mut TomlTable)? parent = this.walk(path, path.size() - 1, true);
        if (parent == null) {
            return "`[[#]]` cannot be defined here, because a key in its path is not a table";
        }
        String last = path.get(path.size() - 1);
        String qualified = parent.qualify(last);
        (&mut TomlValue)? existing = parent.getMut(&last);
        if (existing == null) {
            List<TomlValue> items = new ArrayList<>();
            items.add(TomlValue.Table(new TomlTable("$qualified[0]")));
            parent.put(last, TomlValue.Array(items));
            return null;
        }
        return switch (existing) {
            case Array(List<TomlValue> items) -> {
                if (!items.isEmpty() && !TomlValue.allStandardTables(&items)) {
                    yield "`[[#]]` conflicts with the array `$qualified`, which was written inline";
                }
                items.add(TomlValue.Table(new TomlTable("$qualified[${items.size()}]")));
                yield null;
            }
            default -> "`[[#]]` conflicts with the key `$qualified`, which is not an array";
        };
    }

    mut String? insert(&List<String> current, &List<String> key, TomlValue value) {
        (&mut TomlTable)? table = this.walk(current, current.size(), false);
        if (table == null) {
            return "the current table cannot hold keys";
        }
        (&mut TomlTable)? target = table.walk(key, key.size() - 1, true);
        if (target == null) {
            return "the key `${TomlWriter.path(key)}` goes through a value that is not a table";
        }
        String last = key.get(key.size() - 1);
        if (target.contains(&last)) {
            return "the key `${target.qualify(last)}` is defined twice";
        }
        if (target.isInline()) {
            return "an inline table cannot be extended";
        }
        value.rebase(target.qualify(last));
        target.put(last, value);
        return null;
    }

    mut void rebase(String path) {
        this.path = path;
        List<String> keys = new ArrayList<>();
        for (&String key : &this.order) {
            keys.add(key);
        }
        for (&String key : &keys) {
            String child = this.qualify(key);
            (&mut TomlValue)? inner = this.values.getMut(key);
            if (inner != null) {
                inner.rebase(child);
            }
        }
    }

    private mut (&mut TomlTable)? walk(&List<String> path, int count, boolean create) borrows this {
        if (count == 0) {
            return this;
        }
        String step = path.get(0);
        if (!this.contains(&step)) {
            if (!create) {
                return null;
            }
            this.put(step, TomlValue.Table(new TomlTable(this.qualify(step))));
        }
        List<String> rest = new ArrayList<>();
        for (int i = 1; i < path.size(); i++) {
            rest.add(path.get(i));
        }
        (&mut TomlValue)? value = this.values.getMut(&step);
        if (value == null) {
            return null;
        }
        return switch (value) {
            case Table(TomlTable inner) -> inner.walk(&rest, count - 1, create);
            case Array(List<TomlValue> items) -> {
                if (items.isEmpty()) {
                    yield null;
                }
                (&mut TomlValue) last = items.getMut(items.size() - 1);
                yield switch (last) {
                    case Table(TomlTable inner) -> inner.isInline() ? null : inner.walk(&rest, count - 1, create);
                    default -> null;
                };
            }
            default -> null;
        };
    }

    private void writeSection(&mut StringBuilder out, String prefix) {
        for (&String key : &this.order) {
            (&TomlValue)? value = this.values.get(key);
            if (value != null && !value.isSection()) {
                out.append("${TomlWriter.key(key)} = ${value.toToml()}\n");
            }
        }
        for (&String key : &this.order) {
            (&TomlValue)? value = this.values.get(key);
            if (value == null || !value.isSection()) {
                continue;
            }
            String name = prefix.isEmpty() ? TomlWriter.key(key) : "$prefix.${TomlWriter.key(key)}";
            switch (value) {
                case Table(TomlTable inner) -> {
                    if (out.length() > 0) {
                        out.append("\n");
                    }
                    out.append("[$name]\n");
                    inner.writeSection(out, name);
                }
                case Array(List<TomlValue> items) -> {
                    for (&TomlValue item : items) {
                        switch (item) {
                            case Table(TomlTable element) -> {
                                if (out.length() > 0) {
                                    out.append("\n");
                                }
                                out.append("[[$name]]\n");
                                element.writeSection(out, name);
                            }
                            default -> {}
                        }
                    }
                }
                default -> {}
            }
        }
    }

    private TomlException wrongType(String key, String expected, &TomlValue value) {
        return new TomlException(
            "`${this.qualify(key)}` must be $expected, not ${value.typeName()}"
        );
    }
}
