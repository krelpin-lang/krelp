package krelp.cli;

final class Help {
    private Help() {}

    static String overview() {
        return "krelp, the Krelpin package manager\n"
            + "\n"
            + "Usage: krelp [-q] COMMAND [ARGS]\n"
            + "\n"
            + "Commands:\n"
            + "    new      Create a package in a new directory\n"
            + "    init     Create a package in the current directory\n"
            + "    build    Compile the package and its dependencies\n"
            + "    check    Check the package for errors without building it\n"
            + "    run      Build and run the program\n"
            + "    test     Build and run the tests\n"
            + "    add      Add a dependency to krelp.toml\n"
            + "    remove   Remove a dependency from krelp.toml\n"
            + "    update   Update the versions in krelp.lock\n"
            + "    tree     Show the dependency tree\n"
            + "    publish  Publish the library to the registry\n"
            + "    clean    Remove the target directory\n"
            + "    help     Show help for a command\n"
            + "\n"
            + "Options:\n"
            + "    -q, --quiet    Print only errors and warnings\n"
            + "    -V, --version  Print the version of krelp\n"
            + "\n"
            + "Environment:\n"
            + "    KRELPINC        The compiler to run (default: krelpinc on the PATH)\n"
            + "    KRELP_HOME      Where downloads are kept (default: ~/.krelp)\n"
            + "    KRELP_REGISTRY  The git URL of the registry index\n";
    }

    static String? of(String command) {
        String build = "    -r, --release  Build optimized, into target/release\n"
            + "        --locked   Fail if krelp.lock would have to change\n";
        if (command == "new") {
            return "Usage: krelp new [--lib] [--name NAME] DIR\n\n"
                + "Creates the directory DIR with a new package in it: a program, or a\n"
                + "library with --lib. The package is named after DIR unless --name is given.\n";
        }
        if (command == "init") {
            return "Usage: krelp init [--lib] [--name NAME]\n\n"
                + "Creates a package in the current directory: a program, or a library with --lib.\n";
        }
        if (command == "build") {
            return "Usage: krelp build [--release] [--locked]\n\n"
                + "Compiles the package and its dependencies. A program is written to\n"
                + "target/debug/NAME, a library to target/debug/libNAME.rlib.\n\n" + build;
        }
        if (command == "check") {
            return "Usage: krelp check [--release] [--locked]\n\n"
                + "Checks the package and its dependencies for errors, without producing code.\n\n" + build;
        }
        if (command == "run") {
            return "Usage: krelp run [--release] [--locked] [-- ARGS...]\n\n"
                + "Builds the program and runs it with ARGS. krelp exits with its exit status.\n\n" + build;
        }
        if (command == "test") {
            return "Usage: krelp test [--release] [--locked]\n\n"
                + "Builds and runs the @Test methods in src, and those in tests, a source\n"
                + "directory of package `tests` that uses the package as a library. Tests\n"
                + "may use the dev-dependencies.\n\n" + build;
        }
        if (command == "add") {
            return "Usage: krelp add NAME[@VERSION] [--dev]\n"
                + "       krelp add NAME --path DIR [--dev]\n"
                + "       krelp add NAME --git URL [--branch B | --tag T | --rev R] [--dev]\n\n"
                + "Adds a dependency to krelp.toml, or replaces the one of the same name.\n"
                + "Without VERSION, the newest version in the registry is added.\n\n"
                + "    --dev  Add it to [dev-dependencies], for the tests only\n";
        }
        if (command == "remove") {
            return "Usage: krelp remove [--dev] NAME...\n\n"
                + "Removes dependencies from krelp.toml.\n\n"
                + "    --dev  Remove them only from [dev-dependencies]\n";
        }
        if (command == "update") {
            return "Usage: krelp update [NAME...]\n\n"
                + "Picks the newest versions that krelp.toml allows and writes them to\n"
                + "krelp.lock: of the packages named, or of every package.\n";
        }
        if (command == "tree") {
            return "Usage: krelp tree [--locked]\n\n"
                + "Shows the packages the package depends on, directly and indirectly.\n"
                + "A package shown before is marked (*).\n";
        }
        if (command == "publish") {
            return "Usage: krelp publish [--dry-run] [--allow-dirty]\n\n"
                + "Records in the registry index that this version of the library is the\n"
                + "current commit of its git repository, and pushes the index. The commit\n"
                + "must already be pushed. Dependencies must come from the registry.\n\n"
                + "    --dry-run      Check everything, but change nothing\n"
                + "    --allow-dirty  Publish even if there are uncommitted changes\n";
        }
        if (command == "clean") {
            return "Usage: krelp clean\n\nRemoves the target directory.\n";
        }
        if (command == "help") {
            return "Usage: krelp help [COMMAND]\n\nShows help for krelp or for a command.\n";
        }
        return null;
    }
}
