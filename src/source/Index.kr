package krelp.source;

import krelp.semver.Version;
import krelp.toml.TomlException;
import krelp.toml.TomlParser;
import krelp.toml.TomlTable;
import krelp.toml.TomlValue;
import krelp.util.Fs;
import krelp.util.KrelpException;
import krelp.util.Shell;
import std.io.Files;
import std.io.IOException;
import std.io.Path;
import std.util.ArrayList;
import std.util.List;

final class Index {
    public static String DEFAULT = "https://github.com/krelpin-lang/registry.git";

    private String url;
    private Repository repository;
    private Shell shell;
    private boolean fresh;

    Index(String url, Home home, Shell shell) {
        this.url = url;
        this.repository = new Repository(home.index(url));
        this.shell = shell;
        this.fresh = false;
    }

    String url() {
        return this.url;
    }

    String dir() {
        return this.repository.dir();
    }

    Repository repository() {
        return this.repository;
    }

    boolean isFresh() {
        return this.fresh;
    }

    mut void update() throws KrelpException {
        if (this.fresh) {
            return;
        }
        String dir = this.dir();
        if (this.isCloned()) {
            this.shell.status("Updating", "registry index ${this.url}");
            this.repository.run("fetch", "--quiet", "origin");
            this.repository.run("reset", "--quiet", "--hard", "FETCH_HEAD");
        } else {
            this.shell.status("Fetching", "registry index ${this.url}");
            try {
                Fs.removeAll(dir);
                Files.createDirectories(Path.parent(dir));
            } catch (IOException e) {
                throw new KrelpException(e.getMessage() ?: "couldn't create `$dir`");
            }
            Repository.clone(this.url, dir, "--quiet");
        }
        this.fresh = true;
    }

    mut List<IndexEntry> versions(String name) throws KrelpException {
        if (!this.isCloned()) {
            this.update();
        }
        String file = this.file(name);
        List<IndexEntry> entries = new ArrayList<>();
        if (!Files.isFile(file)) {
            return entries;
        }
        try {
            TomlTable root = TomlParser.parse(Files.readString(file), file);
            (&List<TomlValue>)? versions = root.array("version");
            if (versions == null) {
                return entries;
            }
            for (&TomlValue value : versions) {
                switch (value) {
                    case Table(TomlTable table) -> entries.add(IndexEntry.fromToml(name, &table, file));
                    default -> throw new KrelpException("$file: `version` must be an array of tables");
                }
            }
        } catch (IOException e) {
            throw new KrelpException(e.getMessage() ?: "couldn't read `$file`");
        } catch (TomlException e) {
            throw new KrelpException(e.getMessage() ?: "`$file` is not valid TOML");
        }
        return entries;
    }

    mut Version newest(String name) throws KrelpException {
        this.update();
        Version? best = null;
        for (&IndexEntry entry : &this.versions(name)) {
            if (entry.isStable() && (best == null || entry.version().compareTo(&best) > 0)) {
                best = entry.version();
            }
        }
        if (best == null) {
            throw new KrelpException(
                "the registry has no version of `$name`",
                "check the name, or add it with `--path` or `--git`"
            );
        }
        return best;
    }

    mut boolean has(String name, &Version version) throws KrelpException {
        for (&IndexEntry entry : &this.versions(name)) {
            if (entry.version() == version) {
                return true;
            }
        }
        return false;
    }

    String file(String name) {
        return Path.join(Path.join(this.dir(), "packages"), "$name.toml");
    }

    private boolean isCloned() {
        return Files.isDirectory(Path.join(this.dir(), ".git"));
    }
}
