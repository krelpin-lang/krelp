package tests;

import krelp.semver.SemverException;
import krelp.semver.Version;
import krelp.semver.VersionReq;
import std.util.ArrayList;
import std.util.List;

class SemverTest {
    static boolean matches(String req, String version) {
        try {
            return VersionReq.parse(req).matches(&Version.parse(version));
        } catch (SemverException e) {
            throw new IllegalStateException(e.getMessage() ?: "");
        }
    }

    static String error(String req) {
        try {
            VersionReq.parse(req);
            return "no error";
        } catch (SemverException e) {
            return e.getMessage() ?: "";
        }
    }

    @Test
    static void ordersVersions() {
        List<Version> versions = new ArrayList<>();
        String[] texts = {"1.0.0", "1.0.0-alpha", "0.9.12", "1.0.0-alpha.1", "1.0.0-beta.11", "1.0.0-beta.2", "1.0.0-rc.1", "10.0.0", "2.1.0"};
        try {
            for (String text : texts) {
                versions.add(Version.parse(text));
            }
        } catch (SemverException e) {
            throw new IllegalStateException(e.getMessage() ?: "");
        }
        versions.sort();
        StringBuilder out = new StringBuilder();
        for (&Version v : versions) {
            out.append("$v ");
        }
        Check.equal(out.toString().trim(), "0.9.12 1.0.0-alpha 1.0.0-alpha.1 1.0.0-beta.2 1.0.0-beta.11 1.0.0-rc.1 1.0.0 2.1.0 10.0.0");
    }

    @Test
    static void caretRequirements() {
        Check.that(matches("1.2.3", "1.9.0"), "1.2.3 to accept 1.9.0");
        Check.that(!matches("1.2.3", "2.0.0"), "1.2.3 to reject 2.0.0");
        Check.that(!matches("1.2.3", "1.2.2"), "1.2.3 to reject 1.2.2");
        Check.that(matches("^0.2.3", "0.2.9"), "^0.2.3 to accept 0.2.9");
        Check.that(!matches("^0.2.3", "0.3.0"), "^0.2.3 to reject 0.3.0");
        Check.that(!matches("^0.0.3", "0.0.4"), "^0.0.3 to reject 0.0.4");
        Check.that(matches("^0", "0.9.0"), "^0 to accept 0.9.0");
        Check.that(matches("1", "1.5.0"), "1 to accept 1.5.0");
        Check.that(!matches("1", "2.0.0-beta"), "1 to reject 2.0.0-beta");
        Check.that(!matches("1", "1.5.0-beta"), "1 to reject 1.5.0-beta");
        Check.that(matches("^1.0.0-beta", "1.0.0-rc.1"), "^1.0.0-beta to accept 1.0.0-rc.1");
    }

    @Test
    static void otherRequirements() {
        Check.that(matches("~1.2.3", "1.2.9"), "~1.2.3 to accept 1.2.9");
        Check.that(!matches("~1.2.3", "1.3.0"), "~1.2.3 to reject 1.3.0");
        Check.that(matches("=1.2", "1.2.7"), "=1.2 to accept 1.2.7");
        Check.that(!matches("=1.2.3", "1.2.4"), "=1.2.3 to reject 1.2.4");
        Check.that(matches(">=1.0, <1.5", "1.4.9"), ">=1.0, <1.5 to accept 1.4.9");
        Check.that(!matches(">=1.0, <1.5", "1.5.0"), ">=1.0, <1.5 to reject 1.5.0");
        Check.that(!matches(">1.2", "1.2.5"), ">1.2 to reject 1.2.5");
        Check.that(matches("<=1.2", "1.2.5"), "<=1.2 to accept 1.2.5");
        Check.that(matches("*", "7.0.0"), "* to accept 7.0.0");
        Check.that(matches("1.*", "1.8.0"), "1.* to accept 1.8.0");
        Check.that(!matches("1.2.*", "1.3.0"), "1.2.* to reject 1.3.0");
    }

    @Test
    static void rejectsMalformedText() {
        Check.equal(error(""), "the version requirement is empty; use `*` to accept any version");
        Check.equal(error("1.02"), "`1.02` has a number with a leading zero, `02`");
        Check.equal(error("1.a"), "`1.a` has an invalid number `a`");
        Check.equal(error(">=1.*"), "`>=1.*` combines `>=` with a wildcard");
        Check.equal(error("1.0,"), "`1.0,` has an empty condition between commas");
    }
}
