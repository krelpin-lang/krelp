package krelp.ops;

import krelp.build.Compiler;
import krelp.build.Goal;
import krelp.build.Profile;
import krelp.manifest.Manifest;
import krelp.resolve.Library;
import krelp.util.KrelpException;
import krelp.util.Shell;
import std.io.Files;
import std.io.IOException;
import std.io.Path;
import std.process.Command;
import std.util.ArrayList;
import std.util.List;

final class Builder {
    private final Project project;
    private final Profile profile;
    private final Shell shell;
    private final String compiler;

    Builder(Project project, Profile profile, &Krelp krelp) {
        this.project = project;
        this.profile = profile;
        this.shell = krelp.shell();
        this.compiler = krelp.compiler();
    }

    void check() throws KrelpException {
        long start = System.currentTimeMillis();
        this.compile(Goal.CHECK, "");
        this.finished(start);
    }

    String build() throws KrelpException {
        long start = System.currentTimeMillis();
        String output = this.compile(Goal.BUILD, this.artifact());
        this.finished(start);
        return output;
    }

    int run(&List<String> args) throws KrelpException {
        &Manifest manifest = this.project.manifest();
        if (!manifest.isProgram()) {
            throw new KrelpException(
                "`${manifest.name()}` is a library, so there is nothing to run",
                "a program has a `src/Main.kr` with `static void main(String[] args)`"
            );
        }
        String program = this.build();
        Command command = new Command(program);
        for (&String arg : args) {
            command.arg(arg);
        }
        this.shell.status("Running", this.project.shown(program));
        try {
            return command.status();
        } catch (IOException e) {
            throw new KrelpException(e.getMessage() ?: "couldn't run `$program`");
        }
    }

    void test() throws KrelpException {
        &Manifest manifest = this.project.manifest();
        long start = System.currentTimeMillis();
        String dir = this.project.targetDir(this.profile.dirName());
        List<String> programs = new ArrayList<>();
        programs.add(this.compile(Goal.UNIT_TESTS, Path.join(dir, "${manifest.name()}-unittests")));
        if (this.hasSources(manifest.testsDir())) {
            programs.add(this.compile(Goal.INTEGRATION_TESTS, Path.join(dir, "${manifest.name()}-tests")));
        }
        this.finished(start);
        int failed = 0;
        for (&String program : &programs) {
            this.shell.status("Running", this.project.shown(program));
            try {
                if (new Command(program).status() != 0) {
                    failed++;
                }
            } catch (IOException e) {
                throw new KrelpException(e.getMessage() ?: "couldn't run `$program`");
            }
        }
        if (failed > 0) {
            throw new KrelpException(failed == 1 ? "a test program failed" : "$failed test programs failed");
        }
    }

    private String compile(Goal goal, String output) throws KrelpException {
        &Manifest manifest = this.project.manifest();
        List<Library> libraries = this.project.resolution().libraries(goal.isTest());
        String crate = manifest.name();
        String input = manifest.srcDir();
        if (goal == Goal.INTEGRATION_TESTS) {
            libraries.add(new Library(manifest.name(), manifest.srcDir()));
            crate = "tests";
            input = manifest.testsDir();
        }
        if (!this.hasSources(manifest.srcDir())) {
            throw new KrelpException(
                "`${manifest.srcDir()}` holds no `.kr` files",
                "put the sources of `${manifest.name()}` in `src`"
            );
        }
        for (&Library library : &libraries) {
            if (goal == Goal.INTEGRATION_TESTS && library.name() == manifest.name()) {
                continue;
            }
            this.shell.status("Compiling", this.project.describe(library.name()));
        }
        String what = goal == Goal.INTEGRATION_TESTS ? "tests" : "${manifest.name()} v${manifest.version()}";
        this.shell.status(goal.verb(), "$what (${manifest.dir()})");
        Compiler compiler = new Compiler(this.compiler, crate, input, manifest.edition(), libraries);
        if (!compiler.run(goal, this.profile, !manifest.isProgram(), output)) {
            throw new KrelpException("couldn't compile `${manifest.name()}` because of the errors above");
        }
        return output;
    }

    private String artifact() throws KrelpException {
        &Manifest manifest = this.project.manifest();
        String name = manifest.isProgram() ? manifest.name() : "lib${manifest.name()}.rlib";
        return Path.join(this.project.targetDir(this.profile.dirName()), name);
    }

    private void finished(long start) {
        long tenths = (System.currentTimeMillis() - start) / 10L;
        this.shell.status("Finished", "${this.profile.describe()} in ${tenths / 100L}.${(tenths % 100L).format("02")}s");
    }

    private boolean hasSources(String dir) {
        if (!Files.isDirectory(dir)) {
            return false;
        }
        try {
            for (String name : Files.list(dir)) {
                String path = Path.join(dir, name);
                if (name.endsWith(".kr") && Files.isFile(path)) {
                    return true;
                }
                if (Files.isDirectory(path) && this.hasSources(path)) {
                    return true;
                }
            }
        } catch (IOException e) {
            return false;
        }
        return false;
    }
}
