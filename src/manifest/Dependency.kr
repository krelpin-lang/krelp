package krelp.manifest;

import krelp.semver.VersionReq;
import krelp.source.SourceId;
import krelp.toml.TomlWriter;
import krelp.util.Fs;
import krelp.util.KrelpException;
import std.io.Files;

record Dependency(String name, DepKind kind, VersionReq req, boolean dev) {
    Dependency copy() {
        return new Dependency(this.name, this.kind, this.req.copy(), this.dev);
    }

    boolean isRegistry() {
        return switch (this.kind) {
            case Registry -> true;
            default -> false;
        };
    }

    SourceId sourceFrom(String from, String dir, String registry) throws KrelpException {
        return switch (this.kind) {
            case Path(String path) -> {
                String resolved = Fs.resolve(dir, path);
                if (!Files.isDirectory(resolved)) {
                    throw new KrelpException(
                        "`$from` depends on `${this.name}` at `$path`, but `$resolved` is not a directory"
                    );
                }
                yield SourceId.Path(resolved);
            }
            case Git(String url, GitRef ref) -> {
                boolean remote = url.contains("://") || url.contains("@") || url.startsWith("/");
                String resolved = Fs.resolve(dir, url);
                yield SourceId.Git(!remote && Files.isDirectory(resolved) ? resolved : url, ref);
            }
            case Registry -> SourceId.Registry(registry);
        };
    }

    String toToml() {
        String version = this.req.toString();
        String quoted = TomlWriter.string(version);
        return switch (this.kind) {
            case Registry -> quoted;
            case Path(String dir) -> version == "*"
                ? "{ path = ${TomlWriter.string(dir)} }"
                : "{ path = ${TomlWriter.string(dir)}, version = $quoted }";
            case Git(String url, GitRef ref) -> "{ git = ${TomlWriter.string(url)}${ref.tomlEntry()} }";
        };
    }
}
